{
  "root": true,

  /* --------------- ignore compiled / archived / backup artefacts ---------- */
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "_archive/**",
    "**/*.bak",
    "**/*.bak.*"
  ],

  /* ----------------------- environments ----------------------------------- */
  "env": { "browser": true, "es2021": true, "node": true },

  /* ----------------------------- presets ---------------------------------- */
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended"
  ],

  /* ----------------------- parser options --------------------------------- */
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "module" },

  /* ---------------------- extra plug‑ins ---------------------------------- */
  "plugins": ["react", "react-hooks", "unused-imports"],

  "settings": { "react": { "version": "detect" } },

  /* --------------------------- rules -------------------------------------- */
  "rules": {
    /* ---- unused stuff ---------------------------------------------------- */
    "no-unused-vars": "off",                             // replaced below
    "unused-imports/no-unused-imports": "error",         //  auto‑deletes dead imports on --fix
    "unused-imports/no-unused-vars": [
      "error",
      {
        "vars": "all",
        "varsIgnorePattern": "^_",      // const _foo = …
        "args": "after-used",
        "argsIgnorePattern": "^_"       // (err, _next) => …
      }
    ],

    /* ---- react / hooks --------------------------------------------------- */
    // still catch wrong hook order, but only warn on deps‑list spam for now
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",

    // relax a few noisy React rules while you refactor
    "react/no-unescaped-entities": "off",
    "react/prop-types": "off",
    "react-refresh/only-export-components": "warn",

    /* ---- general JS / style --------------------------------------------- */
    "no-irregular-whitespace": "off",
    "no-unreachable": "warn"
  }
}
