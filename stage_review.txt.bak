  2326	
  2327	      // throttle consecutive transitions
  2328	      const throttle =
  2329	        state.currentDisplayPreset?.transitionDuration || DEFAULT_TRANSITION_DURATION;
  2330	      if (state.isTransitioning && now - state.lastTransitionTime < throttle) return;
  2331	
  2332	      // same mood? do nothing
  2333	      if (newMoodName === state.currentMood && !state.isTransitioning) return;
  2334	
  2335	      const targetPreset = getNarrativePresetConfig(newMoodName);
  2336	      if (!targetPreset) {
  2337	        console.error(`[NarrativeStore] Unknown mood “${newMoodName}”. Reverting to fallback.`);
  2338	        return get().setMood(FALLBACK_PRESET_KEY);
  2339	      }
  2340	
  2341	      const fromPreset = state.isTransitioning
  2342	        ? state.moodTransitionInternal.toPreset
  2343	        : state.currentDisplayPreset;
  2344	
  2345	      set({
  2346	        currentMood: newMoodName,
  2347	        currentStage: newMoodName, // keep alias in-sync
  2348	        isTransitioning: true,
  2349	        transitionProgress: 0,
  2350	        lastTransitionTime: now,
  2351	        moodTransitionInternal: {
  2352	          fromPreset,
  2353	          toPreset: targetPreset,
  2354	          startTime: now,
  2355	          duration:
  2356	            transitionOpts.duration ??
  2357	            targetPreset.transitionDuration ??
  2358	            DEFAULT_TRANSITION_DURATION,
  2359	        },
  2360	      });
  2361	    },
  2362	
  2363	    updateTransition: currentTimeMs => {
