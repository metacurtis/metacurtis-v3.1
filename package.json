{
  "name": "metacurtis-v3.1",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:phase1": "vite build",
    "preview": "vite preview",
    "start": "vite preview --port=5000 --strictPort",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "fix:all": "npm run lint:fix && npm run format",
    "test": "vitest run --passWithNoTests --exclude tests/visual/**",
    "test:coverage": "vitest run --coverage --reporter=html",
    "test:watch": "vitest watch",
    "lighthouse": "lhci autorun --config=./lighthouserc.json",
    "lighthouse:full": "npm run build && npm run lighthouse",
    "validate": "node scripts/validate-sst.js && node tools/sentinel.mjs",
    "validate:sst": "node ./scripts/validate-sst-integration.js",
    "predev": "npm run validate",
    "prebuild": "npm run validate",
    "prepare": "husky install",
    "fix": "node scripts/apply-fix.js",
    "fix:sst": "node scripts/apply-sst-v3-fixes.js",
    "doctor": "node scripts/render-contract-verify.cjs --fix && node scripts/snapshot-render-stack.cjs",
    "doctor:verify": "node scripts/render-contract-verify.cjs",
    "canon:level2": "node scripts/canon-level2.cjs",
    "canon:level2:verify": "node scripts/canon-console-verify.js",
    "canon:bridge:l2": "node scripts/canon-guard-l2-bridge.cjs",
    "canon:bridge:l2:verify": "node scripts/canon-console-verify.js",
    "canon:pilot:install": "node scripts/canon-pilot-install.cjs",
    "canon:pilot:verify": "node scripts/canon-pilot-verify.mjs",
    "guard:finish": "node scripts/finish-guard-console.cjs",
    "console:l2:finish": "node scripts/finish-guard-console.cjs",
    "hot-dors": "node scripts/hot-dors.v2.cjs",
    "sprint:start": "node scripts/sprintctl.cjs start",
    "sprint:snapshot": "node scripts/sprintctl.cjs snapshot",
    "sprint:stop": "node scripts/sprintctl.cjs stop",
    "sprint:status": "node scripts/sprintctl.cjs status",
    "sprint:note": "node scripts/sprintctl.cjs note",
    "doctor:render": "node scripts/render-doctor.v2.cjs",
    "doctor:perf": "node scripts/doctor-perf.cjs",
    "doctor:perf:strict": "node scripts/doctor-perf.cjs --strict-perf",
    "doctor:repo": "npm run validate && npm run doctor:perf",
    "evidence:rollup": "node scripts/evidence-rollup.cjs",
    "sst:verify": "node tools/sentinel.mjs",
    "agent:run": "node scripts/agent/runner.mjs",
    "validate:opening": "node tools/sentinel.mjs --opening",
    "validate:vision": "node tools/sentinel.mjs --vision",
    "agent:visuals": "node scripts/agent/goals/visuals.mjs",
    "agent:record": "node scripts/agent/goals/record.mjs",
    "doctor:agents": "node scripts/doctor.catalog-agents-sentinels.mjs --write",
    "opening:check": "node tools/sentinel.mjs --opening --vision && node scripts/agent/runner.mjs --goal=opening:visuals",
    "canon:verify": "node tools/sentinel.mjs --opening && node scripts/canon-console-verify.mjs",
    "ci:fencepost": "node tools/sentinel.mjs --opening && node scripts/ci/opening-fencepost-check.mjs",
    "devos:verify": "node scripts/ci/opening-fencepost-check.mjs || true",
    "validate:single-writer": "grep -r 'setAttribute\\|setDrawRange\\|material\\.uniforms' src --include='*.js' --include='*.jsx' | grep -v 'WebGL' && echo '⛔ GPU writes outside renderer' && exit 1 || echo '✅ Single-writer clean'",
    "canon:critical": "node scripts/hotdors-critical-four-final.mjs",
    "canon:critical:verify": "node scripts/hotdors-critical-four-final.mjs --verify",
    "canon:verify:all": "npm run canon:critical:verify && npm run validate:opening && npm run ci:fencepost",
    "test:fencepost": "./scripts/ci/run-fencepost-test.sh",
    "ci:fencepost:wait": "./scripts/ci/wait-and-test.sh",
    "ci:test:parallel": "npm-run-all --parallel --race dev ci:fencepost:wait",
    "test:all": "npm run canon:critical:verify && npm run test:fencepost",
    "ci:guards": "node tools/guard-bus-path.cjs && node tools/guard-wbg-policy.cjs",
    "test:visual": "playwright test tests/visual/ --workers=1",
    "test:visual:ui": "playwright test tests/visual/ --ui",
    "test:visual:debug": "playwright test tests/visual/ --debug",
    "test:report": "playwright show-report",
    "test:schema": "node sst/tools/test-schema.cjs",
    "validate-sst": "node sst/tools/validate-sst.cjs",
    "test:sst-all": "npm run test:schema && npm run validate-sst",
    "generate-types": "node sst/tools/generate-jsdoc.cjs",
    "detect-drift": "node sst/tools/detect-drift.cjs",
    "audit-orchestration": "node scripts/validate-sst-orchestration.cjs",
    "sst-check": "npm run validate-sst && npm run detect-drift",
    "ai-context": "node sst/tools/ai-context-builder.cjs",
    "system:validate": "node scripts/system.mjs validate",
    "system:doctor": "node scripts/system.mjs doctor",
    "system:query": "node scripts/system.mjs query",
    "system:fix": "node scripts/system.mjs fix",
    "test:contracts": "node tests/contracts/blueprint-tests.cjs",
    "build-evidence": "npm run sst-extract && npm run trace-bus && npm run scan-source && npm run scan-audio && npm run scan-shaders && npm run scan-shaders-advanced && npm run scan-shaders-motion && node tools/build-report.mjs && npm run scan-beat-verbs",
    "sst-extract": "node tools/sst-extract.mjs",
    "trace-bus": "node tools/trace-bus.mjs",
    "scan-single-writer": "node tools/scan-single-writer.mjs",
    "scan-bloat": "node tools/scan-bloat.mjs",
    "gate:opening": "npm run validate:opening && npm run scan-single-writer",
    "gate:topology": "npm run trace-bus && npm run scan-bloat",
    "scan-source": "node tools/scan-source.mjs",
    "evidence:lint": "node tools/lint-evidence.mjs",
    "events:lint": "node tools/lint-events.mjs",
    "velocity:start": "node tools/velocity.mjs start",
    "velocity:stop": "node tools/velocity.mjs stop \"$npm_config_task\"",
    "onboard": "node tools/onboard.mjs",
    "preflight": "npm run build-evidence && npm run evidence:lint && npm run events:lint && npm run lint-shaders && npm run lint-shaders-advanced && npm run lint-shaders-motion",
    "scan-audio": "node tools/scan-audio.mjs",
    "scan-shaders": "node tools/scan-shaders.mjs",
    "lint-shaders": "node tools/lint-shaders.mjs",
    "scan-shaders-advanced": "node tools/scanners/shader-audit.mjs",
    "lint-shaders-advanced": "node tools/lint-shaders-advanced.mjs",
    "scan-shaders-motion": "node tools/scanners/shader-motion-audit.mjs",
    "lint-shaders-motion": "node tools/lint-shaders-motion.mjs",
    "scan-beat-verbs": "node tools/scanners/scan-beat-verbs.mjs",
    "scan-navigation": "node tools/scan-navigation.mjs",
    "analyze-flow": "node tools/analyze-control-flow.mjs",
    "test:centralization": "vitest run tests/contracts/event-centralization.spec.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.1.2",
    "gsap": "^3.13.0",
    "opentype.js": "^1.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "seedrandom": "^3.0.5",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.3",
    "@babel/parser": "^7.28.3",
    "@babel/traverse": "^7.28.3",
    "@babel/types": "^7.28.2",
    "@eslint/js": "^9.24.0",
    "@lhci/cli": "^0.12.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@tailwindcss/vite": "^4.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.12.0",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^2.1.1",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.6.0",
    "clipboardy": "^3.0.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-glob": "^3.3.3",
    "glob": "^10.3.10",
    "globals": "^16.0.0",
    "husky": "^8.0.3",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.2.7",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.55.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.7",
    "terser": "^5.39.0",
    "vite": "^6.2.5",
    "vite-plugin-glsl": "^1.4.0",
    "vitest": "^1.4.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "src/**/*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
