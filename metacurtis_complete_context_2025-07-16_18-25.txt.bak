      get().setCurrentQualityTier('ULTRA');
      console.log('🎨 qualityStore: Showcase mode enabled - ULTRA quality');
    } else {
      console.warn('🎨 qualityStore: Showcase mode unavailable - insufficient performance');
    }
  },
  
  // ✅ SST v2.0 QUERY METHODS (Atomic migration compatible)
  getQualityConfig: () => {
    const state = get();
    const config = SST_V2_QUALITY_MULTIPLIERS[state.currentQualityTier] || SST_V2_QUALITY_MULTIPLIERS.HIGH;
    
    return {
      tier: state.currentQualityTier,
      particles: state.particleCount,
      dpr: state.targetDpr,
      webgl: state.webglEnabled,
      config,
      deviceClass: state.performanceClass,
    };
  },
  
  getScalingStatus: () => {
    const state = get();
    return {
      currentTier: state.currentQualityTier,
      canScaleToUltra: state.canScaleToUltra,
      deviceClass: state.performanceClass,
      lastChange: state.lastTierChange,
      particleCount: state.particleCount,
    };
  },
  
  // ✅ DEVELOPMENT UTILITIES
  getAllQualityTiers: () => SST_V2_QUALITY_TIERS,
  
  forceQualityTier: (tier) => {
    if (process.env.NODE_ENV === 'development') {
      get().setCurrentQualityTier(tier);
      console.log(`🎨 qualityStore: FORCED tier to ${tier}`);
    }
  },
  
  resetQuality: () => {
    set({
      currentQualityTier: 'HIGH',
      targetDpr: 1.0,
      frameloopMode: 'always',
      webglEnabled: true,
      particleCount: 5000,
      canScaleToUltra: false,
      lastTierChange: 0,
    });
    console.log('🎨 qualityStore: Reset to defaults');
  },
}));

// ✅ DEVELOPMENT ACCESS
if (typeof window !== 'undefined' && process.env.NODE_ENV === 'development') {
  window.useQualityStore = useQualityStore;
  
  window.qualityControls = {
    setTier: (tier) => useQualityStore.getState().setCurrentQualityTier(tier),
    getConfig: () => useQualityStore.getState().getQualityConfig(),
    getStatus: () => useQualityStore.getState().getScalingStatus(),
    enableShowcase: () => useQualityStore.getState().enableShowcaseMode(),
    getAllTiers: () => useQualityStore.getState().getAllQualityTiers(),
  };
  
  console.log('🎨 qualityStore: SST v2.0 compliant quality management ready');
  console.log('🎮 Available: window.qualityControls');
}

