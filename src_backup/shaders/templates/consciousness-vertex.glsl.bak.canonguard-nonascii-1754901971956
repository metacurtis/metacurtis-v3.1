// consciousness-vertex.glsl
// SST v3.0 COMPLIANT - MetaCurtis v3.1 (safe precision + dynamic atlas + depth guard)

precision highp float;
precision highp int;

// === ATTRIBUTES (Must match WebGLBackground.jsx) ===
attribute vec3 position;               // standard Three.js attribute (not used, OK)
attribute vec3 atmosphericPosition;
attribute vec3 allenAtlasPosition;
attribute float particleIndex;
attribute float tierData;
attribute vec3 animationSeed;
attribute float sizeMultiplier;
attribute float opacityData;
attribute float atlasIndex;

// === UNIFORMS (From WebGLBackground.jsx material definition) ===
// Three.js built-ins
uniform mat4 modelViewMatrix;
uniform mat4 projectionMatrix;
uniform vec3 cameraPosition;

// Time & morph
uniform float uTime;
uniform float uMorphProgress;
uniform float uScrollProgress;
uniform float uStageProgress;  // Alias for uMorphProgress
uniform float uStageBlend;     // Alias for uScrollProgress

// Display
uniform float uPointSize;
uniform float uDevicePixelRatio;
uniform vec2  uResolution;

// Tier & fade
uniform float uActiveCount;
uniform float uTierCutoff;
uniform float uFadeProgress;
uniform float uGaussianSigma;
uniform float uTierHighlight[4];

// Feature toggles
uniform float uGaussianFalloff;
uniform float uCenterWeighting;

// Stage meta
uniform float uStageIndex;
uniform float uBrainRegion;

// Atlas meta (needed for dynamic UV grid)
uniform float uTotalSprites;

// === VARYINGS (To fragment shader) ===
varying float vBlend;
varying float vAlpha;
varying vec2  vAtlasUVOffset;
varying float vTierID;
varying float vSizeMultiplier;
varying float vParticleIndex;

// === HELPERS ===
float easeInOutCubic(float t) {
  return t < 0.5 ? 4.0 * t * t * t : 1.0 - pow(-2.0 * t + 2.0, 3.0) / 2.0;
}

float oscillate(float time, float frequency, float amplitude) {
  return sin(time * frequency) * amplitude;
}

// Dynamic grid from uTotalSprites (supports 1, 4, 9, 16, …)
vec2 getAtlasUVOffset(float index) {
  float total = max(uTotalSprites, 1.0);
  float gridSize = floor(sqrt(total) + 0.5);
  float spriteSize = 1.0 / gridSize;
  float ix = clamp(index, 0.0, total - 1.0);
  float col = mod(ix, gridSize);
  float row = floor(ix / gridSize);
  return vec2(col * spriteSize, row * spriteSize);
}

// === MAIN ===
void main() {
  // Varyings
  vTierID = tierData;
  vSizeMultiplier = sizeMultiplier;
  vParticleIndex = particleIndex;
  vAlpha = opacityData;
  vBlend = uMorphProgress;

  // Clamp atlas index into range
  float totalSprites = max(uTotalSprites, 1.0);
  float safeAtlasIndex = clamp(atlasIndex, 0.0, totalSprites - 1.0);
  vAtlasUVOffset = getAtlasUVOffset(safeAtlasIndex);

  // Morph atmospheric -> brain
  float morphT = clamp(uMorphProgress, 0.0, 1.0);
  float easedMorph = easeInOutCubic(morphT);
  vec3 morphedPosition = mix(atmosphericPosition, allenAtlasPosition, easedMorph);

  // Tier-specific motion
  vec3 animatedPosition = morphedPosition;

  if (tierData < 0.5) {
    float driftX = oscillate(uTime + animationSeed.x * 10.0, 0.5, 2.0);
    float driftY = oscillate(uTime + animationSeed.y * 10.0, 0.3, 1.5);
    float driftZ = oscillate(uTime + animationSeed.z * 10.0, 0.4, 1.0);
    float driftAmount = 1.0 - morphT;
    animatedPosition.x += driftX * driftAmount;
    animatedPosition.y += driftY * driftAmount;
    animatedPosition.z += driftZ * driftAmount * 0.5;
  } else if (tierData < 1.5) {
    float orbitSpeed = 0.2 + animationSeed.x * 0.1;
    float orbitRadius = 5.0 * (1.0 - morphT * 0.5);
    float angle = uTime * orbitSpeed;
    animatedPosition.x += cos(angle) * orbitRadius;
    animatedPosition.y += sin(angle) * orbitRadius * 0.7;
    animatedPosition.z += sin(angle * 2.0) * orbitRadius * 0.3;
  } else if (tierData < 2.5) {
    float pulseFreq = 2.0 + animationSeed.z * 2.0;
    float pulse = 1.0 + oscillate(uTime * pulseFreq, 1.0, 0.2);
    animatedPosition *= pulse;
    float rotSpeed = 0.1 + animationSeed.x * 0.05;
    mat2 rotation = mat2(cos(uTime * rotSpeed), -sin(uTime * rotSpeed),
                         sin(uTime * rotSpeed),  cos(uTime * rotSpeed));
    animatedPosition.xy = rotation * animatedPosition.xy;
  } else {
    float gentleBob = oscillate(uTime * 0.5 + animationSeed.y * 5.0, 1.0, 0.5);
    animatedPosition.y += gentleBob;
    float prominence = 1.0 + sin(uTime + animationSeed.x * 10.0) * 0.05;
    animatedPosition *= prominence;
  }

  // Stage “signature”
  float stageRotation = uStageIndex * 0.1 + uTime * 0.01;
  mat2 stageRot = mat2(cos(stageRotation), -sin(stageRotation),
                       sin(stageRotation),  cos(stageRotation));
  animatedPosition.xy = stageRot * animatedPosition.xy;

  // View/projection
  vec4 mvPosition = modelViewMatrix * vec4(animatedPosition, 1.0);
  gl_Position = projectionMatrix * mvPosition;

  // Point size (with safe depth)
  float baseSize = uPointSize;
  float tierScale = sizeMultiplier;

  float depth = max(0.001, -mvPosition.z);           // guard against <= 0
  float distanceAttenuation = clamp(300.0 / depth, 0.5, 2.0);

  float fadeOut = 1.0;
  if (particleIndex >= uActiveCount) {
    fadeOut = 0.0;
  } else if (particleIndex > uActiveCount - 500.0) {
    fadeOut = (uActiveCount - particleIndex) / 500.0;
  }

  float tierBoost = 1.0;
  if (tierData >= 2.5)      tierBoost = 1.2;
  else if (tierData >= 1.5) tierBoost = 1.1;

  gl_PointSize = baseSize * tierScale * tierBoost * distanceAttenuation * uDevicePixelRatio * fadeOut;
  gl_PointSize = clamp(gl_PointSize, 1.0, 64.0);

  // Pass alpha fade
  vAlpha *= fadeOut;

  // Extra center fade when brain mode > 0.5
  if (morphT > 0.5) {
    float distFromCenter = length(animatedPosition.xy) / 50.0;
    float centerFade = 1.0 - smoothstep(0.5, 1.5, distFromCenter);
    vAlpha *= mix(1.0, centerFade, (morphT - 0.5) * 2.0);
  }
}
