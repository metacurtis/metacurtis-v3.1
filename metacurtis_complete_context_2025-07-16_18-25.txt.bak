*/// src/stores/qualityStore.js
// ✅ SST v2.0 COMPLIANT QUALITY STORE - Pure JavaScript (Fixed)
// This will be replaced by qualityAtom.js in Phase II

import { create } from 'zustand';

// ✅ SST v2.0 QUALITY TIERS - Pure JavaScript (Fixed)
const SST_V2_QUALITY_TIERS = ['LOW', 'MEDIUM', 'HIGH', 'ULTRA'];

// ✅ SST v2.0 PARTICLE SCALING - Base counts per stage for quality calculation
const SST_V2_BASE_PARTICLES = {
  genesis: 2000,      // 0: Genesis Spark
  discipline: 3000,   // 1: Discipline Forge
  neural: 5000,       // 2: Neural Awakening
  velocity: 12000,    // 3: Velocity Explosion
  architecture: 8000, // 4: Architecture Consciousness
  harmony: 12000,     // 5: Harmonic Mastery
  transcendence: 15000 // 6: Consciousness Transcendence
};

// ✅ SST v2.0 QUALITY MULTIPLIERS - Progressive scaling to 17K particles
const SST_V2_QUALITY_MULTIPLIERS = {
  LOW: { particles: 0.6, dpr: 0.5, effects: 0.8 },
  MEDIUM: { particles: 0.8, dpr: 0.75, effects: 0.9 },
  HIGH: { particles: 1.0, dpr: 1.0, effects: 1.0 },
  ULTRA: { particles: 1.2, dpr: 1.2, effects: 1.1 }
};

export const useQualityStore = create((set, get) => ({
  // ✅ SST v2.0 CURRENT STATE
  currentQualityTier: 'HIGH',
  targetDpr: 1.0,
  frameloopMode: 'always',
  webglEnabled: true,
  particleCount: 5000,
  
  // ✅ SST v2.0 DEVICE AWARENESS (Ready for atomic migration)
  deviceType: 'desktop',
  webglVersion: 'WebGL2',
  performanceClass: 'high',
  
  // ✅ SST v2.0 SCALING CAPABILITY (17K particle support)
  canScaleToUltra: false,
  lastTierChange: 0,
  
  // ✅ SST v2.0 ACTIONS
  setCurrentQualityTier: (tier) => {
    if (!SST_V2_QUALITY_TIERS.includes(tier)) {
      console.warn(`[qualityStore] Invalid tier: ${tier}. Valid tiers:`, SST_V2_QUALITY_TIERS);
      return;
    }
    
    const config = SST_V2_QUALITY_MULTIPLIERS[tier];
    const now = performance.now();
    
    set({
      currentQualityTier: tier,
      targetDpr: config.dpr,
      lastTierChange: now,
    });
    
    // Recalculate particle budget
    get().updateParticleBudget();
    
    console.log(`🎨 qualityStore: Quality tier set to ${tier} (${config.particles}x particles)`);
  },
  
  setTargetDpr: (dpr) => set({ targetDpr: dpr }),
  setFrameloopMode: (mode) => set({ frameloopMode: mode }),
  setWebglEnabled: (isEnabled) => set({ webglEnabled: isEnabled }),
  setParticleCount: (count) => set({ particleCount: count }),
  
  // ✅ SST v2.0 PARTICLE BUDGET CALCULATION
  updateParticleBudget: (stageName = 'genesis') => {
    const state = get();
    const baseCount = SST_V2_BASE_PARTICLES[stageName] || SST_V2_BASE_PARTICLES.genesis;
    const config = SST_V2_QUALITY_MULTIPLIERS[state.currentQualityTier] || SST_V2_QUALITY_MULTIPLIERS.HIGH;
    
    const particleCount = Math.round(baseCount * config.particles);
    
    set({ particleCount });
    
    if (process.env.NODE_ENV === 'development') {
      console.log(`🎨 qualityStore: Particle budget updated - ${stageName}: ${particleCount} particles (${state.currentQualityTier})`);
    }
    
    return particleCount;
  },
  
  // ✅ SST v2.0 DEVICE INITIALIZATION (Atomic migration ready)
  initializeForDevice: (deviceInfo) => {
    const { deviceType, webglVersion, renderer } = deviceInfo;
    
    let performanceClass = 'medium';
    let initialTier = 'HIGH';
    
    if (deviceType === 'mobile' || deviceType === 'tablet') {
      performanceClass = 'medium';
      initialTier = 'MEDIUM';
    } else if (webglVersion === 'WebGL1') {
      performanceClass = 'low';
      initialTier = 'MEDIUM';
    } else if (renderer && renderer.includes('Intel')) {
      performanceClass = 'medium';
      initialTier = 'HIGH';
    } else {
      performanceClass = 'high';
      initialTier = 'HIGH';
    }
    
    set({
      deviceType,
      webglVersion,
      performanceClass,
    });
    
    get().setCurrentQualityTier(initialTier);
    
    console.log(`🎨 qualityStore: Initialized for ${deviceType}/${webglVersion} → ${initialTier}`);
  },
  
  // ✅ SST v2.0 SCALING MANAGEMENT (17K particle preparation)
  updateScalingCapability: (fps, jankRatio) => {
    const canScaleToUltra = fps >= 58 && jankRatio < 0.05;
    
    set({ canScaleToUltra });
    
    // Auto-downgrade if performance drops
    const { currentQualityTier } = get();
    if (currentQualityTier === 'ULTRA' && !canScaleToUltra) {
      get().setCurrentQualityTier('HIGH');
    }
  },
  
  // ✅ SST v2.0 SHOWCASE MODE (17K particles)
  enableShowcaseMode: () => {
