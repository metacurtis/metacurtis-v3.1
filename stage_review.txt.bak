    40	// src/config/narrativeStageOrder.js
    41	// 🎯 MC3V CANONICAL STAGE ORDER - SINGLE SOURCE OF TRUTH
    42	// All systems MUST use this array for stage definitions
    43	
    44	/**
    45	 * ✅ CANONICAL MC3V DIGITAL AWAKENING STAGE ORDER
    46	 * This is the ONLY place where stage order is defined.
    47	 * All other systems must import and use this array.
    48	 */
    49	export const MC3V_STAGE_ORDER = [
    50	  'genesis', // 0: Age 8, Commodore 64 spark (1983)
    51	  'silent', // 1: Marine Corps discipline years (1983-2022)
    52	  'awakening', // 2: AI partnership begins (2022)
    53	  'acceleration', // 3: Rapid development phase (Feb 2025)
    54	  'transcendence', // 4: GLSL mastery achieved (Mar 2025)
    55	];
    56	
    57	/**
    58	 * ✅ STAGE METADATA (derived from canonical order)
    59	 */
    60	export const STAGE_METADATA = {
    61	  totalStages: MC3V_STAGE_ORDER.length,
    62	  firstStage: MC3V_STAGE_ORDER[0],
    63	  lastStage: MC3V_STAGE_ORDER[MC3V_STAGE_ORDER.length - 1],
    64	
    65	  // UI labels for navigation
    66	  stageLabels: {
    67	    genesis: '1983',
    68	    silent: '1983-2022',
    69	    awakening: '2022',
    70	    acceleration: 'Feb 2025',
    71	    transcendence: 'Mar 2025',
    72	  },
    73	
    74	  // Auto-advance timing per stage
    75	  autoAdvanceTiming: {
    76	    genesis: 8000, // 8 seconds - terminal boot sequence
    77	    silent: 6000, // 6 seconds - discipline phase
    78	    awakening: 10000, // 10 seconds - AI partnership emergence
    79	    acceleration: 8000, // 8 seconds - rapid development showcase
    80	    transcendence: 12000, // 12 seconds - GLSL mastery demonstration
    81	  },
    82	
    83	  // Progress mapping (0-1 range per stage)
    84	  getStageProgress: stageIndex => stageIndex / (MC3V_STAGE_ORDER.length - 1),
    85	};
    86	
    87	/**
    88	 * ✅ STANDARDIZED MAPPING UTILITIES
    89	 * Use these everywhere for consistent string↔numeric conversion
    90	 */
    91	export const stageUtils = {
    92	  // String stage name → numeric index
    93	  stageToIndex: stageName => {
    94	    const index = MC3V_STAGE_ORDER.indexOf(stageName);
    95	    if (index === -1) {
    96	      console.warn(`[MC3V] Unknown stage name: "${stageName}". Defaulting to 0.`);
    97	      return 0;
    98	    }
    99	    return index;
   100	  },
   101	
   102	  // Numeric index → string stage name
   103	  indexToStage: index => {
   104	    if (index < 0 || index >= MC3V_STAGE_ORDER.length) {
   105	      console.warn(`[MC3V] Invalid stage index: ${index}. Defaulting to "${MC3V_STAGE_ORDER[0]}".`);
   106	      return MC3V_STAGE_ORDER[0];
   107	    }
   108	    return MC3V_STAGE_ORDER[index];
   109	  },
   110	
   111	  // Get next stage in sequence
   112	  getNextStage: currentStage => {
   113	    const currentIndex = stageUtils.stageToIndex(currentStage);
   114	    const nextIndex = Math.min(currentIndex + 1, MC3V_STAGE_ORDER.length - 1);
   115	    return MC3V_STAGE_ORDER[nextIndex];
   116	  },
   117	
   118	  // Get previous stage in sequence
   119	  getPrevStage: currentStage => {
   120	    const currentIndex = stageUtils.stageToIndex(currentStage);
   121	    const prevIndex = Math.max(currentIndex - 1, 0);
   122	    return MC3V_STAGE_ORDER[prevIndex];
   123	  },
   124	
   125	  // Check if stage exists
   126	  isValidStage: stageName => {
   127	    return MC3V_STAGE_ORDER.includes(stageName);
   128	  },
   129	
   130	  // Check if navigation is possible
   131	  canAdvance: currentStage => {
   132	    const currentIndex = stageUtils.stageToIndex(currentStage);
   133	    return currentIndex < MC3V_STAGE_ORDER.length - 1;
   134	  },
   135	
   136	  canGoBack: currentStage => {
   137	    const currentIndex = stageUtils.stageToIndex(currentStage);
   138	    return currentIndex > 0;
   139	  },
   140	
   141	  // Get stage info for UI
   142	  getStageInfo: stageName => {
   143	    const index = stageUtils.stageToIndex(stageName);
   144	    return {
   145	      name: stageName,
   146	      index,
   147	      label: STAGE_METADATA.stageLabels[stageName] || stageName,
   148	      autoAdvanceTime: STAGE_METADATA.autoAdvanceTiming[stageName] || 5000,
   149	      progress: STAGE_METADATA.getStageProgress(index),
   150	      isFirst: index === 0,
   151	      isLast: index === MC3V_STAGE_ORDER.length - 1,
   152	      canAdvance: stageUtils.canAdvance(stageName),
   153	      canGoBack: stageUtils.canGoBack(stageName),
   154	    };
   155	  },
   156	
   157	  // Get all stages info for UI components
   158	  getAllStagesInfo: () => {
   159	    return MC3V_STAGE_ORDER.map(stage => stageUtils.getStageInfo(stage));
   160	  },
   161	};
   162	
   163	/**
   164	 * ✅ DEVELOPMENT INTEGRITY CHECK
   165	 * Validates that all systems are using the same stage definitions
   166	 */
   167	export const validateStageIntegrity = (narrativePresets = {}) => {
   168	  if (typeof process !== 'undefined' && process.env?.NODE_ENV !== 'development') return true;
   169	
   170	  console.log('🔍 MC3V Stage Integrity Check...');
   171	
   172	  const configStages = Object.keys(narrativePresets);
   173	  let isValid = true;
   174	
   175	  // Check if all canonical stages exist in config
   176	  MC3V_STAGE_ORDER.forEach(stage => {
   177	    if (!configStages.includes(stage)) {
   178	      console.warn(
   179	        `❌ [MC3V] Stage "${stage}" is in canonical order but missing in NARRATIVE_PRESETS.`
   180	      );
   181	      isValid = false;
   182	    }
   183	  });
   184	
   185	  // Check if config has extra stages not in canonical order
   186	  configStages.forEach(stage => {
   187	    if (!MC3V_STAGE_ORDER.includes(stage)) {
   188	      console.warn(
   189	        `⚠️ [MC3V] Stage "${stage}" is in NARRATIVE_PRESETS but not in canonical order.`
   190	      );
   191	    }
   192	  });
   193	
   194	  if (isValid) {
   195	    console.log('✅ MC3V Stage Integrity: All systems aligned');
   196	  } else {
   197	    console.error('❌ MC3V Stage Integrity: Mismatches detected - fix required');
   198	  }
   199	
   200	  return isValid;
   201	};
   202	
   203	// Export default for convenience
   204	export default {
   205	  MC3V_STAGE_ORDER,
   206	  STAGE_METADATA,
   207	  stageUtils,
   208	  validateStageIntegrity,
   209	};
   210	// src/components/ui/navigation/StageNavigation.jsx
   211	// Simple sidebar with five buttons → updates narrativeStore.
   212	
   213	import { useNarrativeStore } from '@/stores/narrativeStore';
   214	
   215	const STAGES = [
   216	  { id: 'genesis', label: '1983' },
   217	  { id: 'silent', label: '1983-2022' },
   218	  { id: 'awakening', label: '2022' },
   219	  { id: 'acceleration', label: 'Feb 2025' },
   220	  { id: 'transcendence', label: 'Mar 2025' },
   221	];
   222	
   223	export default function StageNavigation() {
   224	  const currentStage = useNarrativeStore(s => s.currentStage);
   225	  const setStage = useNarrativeStore(s => s.setStage);
   226	
   227	  return (
   228	    <ul
   229	      style={{
   230	        position: 'fixed',
   231	        top: '50%',
   232	        right: '1rem',
   233	        transform: 'translateY(-50%)',
   234	        zIndex: 22,
   235	        listStyle: 'none',
   236	        padding: 0,
   237	        margin: 0,
   238	      }}
   239	    >
   240	      {STAGES.map(({ id, label }) => (
   241	        <li key={id} style={{ margin: '.5rem 0' }}>
   242	          <button
   243	            onClick={() => setStage(id)}
   244	            style={{
   245	              background: id === currentStage ? '#0D9488' : 'transparent',
   246	              border: '1px solid #0D9488',
   247	              color: id === currentStage ? '#fff' : '#0D9488',
   248	              padding: '.25rem .5rem',
   249	              fontSize: '.75rem',
   250	              cursor: 'pointer',
   251	              transition: 'all .2s',
   252	            }}
   253	          >
   254	            {label}
   255	          </button>
   256	        </li>
   257	      ))}
   258	    </ul>
   259	  );
   260	}
   261	// src/components/narrative/ConsolidatedNavigationController.jsx
   262	// 🎯 SINGLE NAVIGATION SYSTEM - Replaces all other navigation components
   263	// Handles keyboard, UI, auto-advance, and programmatic navigation
   264	
   265	import { useEffect, useRef, useCallback } from 'react';
   266	import { useNarrativeStore } from '@/stores/narrativeStore';
   267	import { narrativeTransition } from '@/config/narrativeParticleConfig';
   268	import {
   269	  MC3V_STAGE_ORDER,
   270	  STAGE_METADATA,
   271	  stageUtils,
   272	  validateStageIntegrity,
   273	} from '@/config/narrativeStageOrder';
   274	import { NARRATIVE_PRESETS } from '@/config/narrativeParticleConfig';
   275	
   276	export default function ConsolidatedNavigationController() {
   277	  const { setStage, currentStage, updateEngagement, isStageFeatureEnabled, getNarrativeSnapshot } =
   278	    useNarrativeStore();
   279	
   280	  // Navigation state
   281	  const transitionTimeoutRef = useRef(null);
   282	  const stageStartTime = useRef(Date.now());
   283	  const autoAdvanceEnabled = useRef(false);
   284	  const isTransitioning = useRef(false);
   285	
   286	  // Once-only narrative events tracking
   287	  const stageReached = useRef(
   288	    MC3V_STAGE_ORDER.reduce((acc, stage) => {
   289	      acc[stage] = false;
   290	      return acc;
   291	    }, {})
   292	  );
   293	
   294	  // ✅ CANONICAL STAGE-BASED NAVIGATION FUNCTIONS
   295	
   296	  const nextStage = useCallback(() => {
   297	    if (isTransitioning.current) return false;
   298	
   299	    const nextStageName = stageUtils.getNextStage(currentStage);
   300	    if (nextStageName === currentStage) return false; // Already at last stage
   301	
   302	    console.log(`🎬 Next: ${currentStage} → ${nextStageName}`);
   303	
   304	    // Trigger transition
   305	    isTransitioning.current = true;
   306	    narrativeTransition.setStage(nextStageName);
   307	    setStage(nextStageName); // ✅ STRING stage name to store
   308	    stageStartTime.current = Date.now();
   309	
   310	    // Trigger events and setup auto-advance
   311	    triggerStageEvents(nextStageName);
   312	    if (autoAdvanceEnabled.current) {
   313	      scheduleAutoAdvance(nextStageName);
   314	    }
   315	
   316	    setTimeout(() => {
   317	      isTransitioning.current = false;
   318	    }, 500);
   319	    return true;
   320	  }, [currentStage, setStage]);
   321	
   322	  const prevStage = useCallback(() => {
   323	    if (isTransitioning.current) return false;
   324	
   325	    const prevStageName = stageUtils.getPrevStage(currentStage);
   326	    if (prevStageName === currentStage) return false; // Already at first stage
   327	
   328	    console.log(`🎬 Previous: ${currentStage} → ${prevStageName}`);
   329	
   330	    isTransitioning.current = true;
   331	    narrativeTransition.setStage(prevStageName);
   332	    setStage(prevStageName); // ✅ STRING stage name to store
   333	    stageStartTime.current = Date.now();
   334	
   335	    clearAutoAdvance();
   336	    triggerStageEvents(prevStageName);
   337	
   338	    setTimeout(() => {
   339	      isTransitioning.current = false;
   340	    }, 500);
   341	    return true;
   342	  }, [currentStage, setStage]);
   343	
   344	  const jumpToStage = useCallback(
   345	    targetStage => {
   346	      if (isTransitioning.current) return false;
   347	      if (!stageUtils.isValidStage(targetStage)) {
   348	        console.warn(`[Navigation] Invalid stage: ${targetStage}`);
   349	        return false;
   350	      }
   351	      if (targetStage === currentStage) return false;
   352	
   353	      console.log(`🎬 Jump: ${currentStage} → ${targetStage}`);
   354	
   355	      isTransitioning.current = true;
   356	      narrativeTransition.setStage(targetStage);
   357	      setStage(targetStage); // ✅ STRING stage name to store
   358	      stageStartTime.current = Date.now();
   359	
   360	      clearAutoAdvance();
   361	      triggerStageEvents(targetStage);
   362	      if (autoAdvanceEnabled.current) {
   363	        scheduleAutoAdvance(targetStage);
   364	      }
   365	
   366	      setTimeout(() => {
   367	        isTransitioning.current = false;
   368	      }, 500);
   369	      return true;
   370	    },
   371	    [currentStage, setStage]
   372	  );
   373	
   374	  // ✅ AUTO-ADVANCE FUNCTIONALITY
   375	
   376	  const scheduleAutoAdvance = useCallback(
   377	    stageName => {
   378	      clearAutoAdvance();
   379	
   380	      const advanceTime = STAGE_METADATA.autoAdvanceTiming[stageName];
   381	      if (advanceTime && stageUtils.canAdvance(stageName)) {
   382	        transitionTimeoutRef.current = setTimeout(() => {
   383	          nextStage();
   384	        }, advanceTime);
   385	
   386	        console.log(`⏰ Auto-advance scheduled for ${stageName}: ${advanceTime}ms`);
   387	      }
   388	    },
   389	    [nextStage]
   390	  );
   391	
   392	  const clearAutoAdvance = useCallback(() => {
   393	    if (transitionTimeoutRef.current) {
   394	      clearTimeout(transitionTimeoutRef.current);
   395	      transitionTimeoutRef.current = null;
   396	    }
   397	  }, []);
   398	
   399	  const toggleAutoAdvance = useCallback(
   400	    enabled => {
   401	      autoAdvanceEnabled.current = enabled;
   402	
   403	      if (enabled) {
   404	        scheduleAutoAdvance(currentStage);
   405	        console.log('▶️ Auto-advance enabled');
   406	      } else {
   407	        clearAutoAdvance();
   408	        console.log('⏸️ Auto-advance disabled');
   409	      }
   410	
   411	      return enabled;
   412	    },
   413	    [currentStage, scheduleAutoAdvance, clearAutoAdvance]
   414	  );
   415	
   416	  // ✅ STAGE EVENT SYSTEM
   417	
   418	  const triggerStageEvents = useCallback(
   419	    stageName => {
   420	      // Trigger once-only events
   421	      if (!stageReached.current[stageName]) {
   422	        stageReached.current[stageName] = true;
   423	
   424	        switch (stageName) {
   425	          case 'silent':
   426	            console.log('🎖️ Narrative Event: Marine discipline foundation');
   427	            if (isStageFeatureEnabled('disciplineEffects')) {
   428	              window.dispatchEvent(
   429	                new CustomEvent('narrativeEvent', {
   430	                  detail: { type: 'disciplineActivated', stage: 'silent' },
   431	                })
   432	              );
   433	            }
   434	            break;
   435	
   436	          case 'awakening':
   437	            console.log('🤖 Narrative Event: AI partnership begins');
   438	            if (isStageFeatureEnabled('metacurtisEmergence')) {
   439	              window.dispatchEvent(
   440	                new CustomEvent('narrativeEvent', {
   441	                  detail: { type: 'metacurtisAwakening', stage: 'awakening' },
   442	                })
   443	              );
   444	            }
   445	            break;
   446	
   447	          case 'acceleration':
   448	            console.log('🚀 Narrative Event: Development acceleration');
   449	            if (isStageFeatureEnabled('accelerationEffects')) {
   450	              window.dispatchEvent(
   451	                new CustomEvent('narrativeEvent', {
   452	                  detail: { type: 'accelerationActivated', stage: 'acceleration' },
   453	                })
   454	              );
   455	            }
   456	            break;
   457	
   458	          case 'transcendence':
   459	            console.log('⚡ Narrative Event: GLSL transcendence achieved');
   460	            if (isStageFeatureEnabled('transcendenceEffects')) {
   461	              window.dispatchEvent(
   462	                new CustomEvent('narrativeEvent', {
   463	                  detail: { type: 'transcendenceAchieved', stage: 'transcendence' },
   464	                })
   465	              );
   466	            }
   467	
   468	            if (isStageFeatureEnabled('contactPortal')) {
   469	              setTimeout(() => {
   470	                window.dispatchEvent(
   471	                  new CustomEvent('narrativeEvent', {
   472	                    detail: { type: 'contactPortalActivated', stage: 'transcendence' },
   473	                  })
   474	                );
   475	              }, 3000);
   476	            }
   477	            break;
   478	        }
   479	      }
   480	
   481	      // Update engagement metrics
   482	      updateEngagement({
   483	        currentStage: stageName,
   484	        stageIndex: stageUtils.stageToIndex(stageName),
   485	        timeInStage: Date.now() - stageStartTime.current,
   486	      });
   487	    },
   488	    [isStageFeatureEnabled, updateEngagement]
   489	  );
   490	
   491	  // ✅ UI HELPER FUNCTIONS (Replaces StageNavigation functionality)
   492	
   493	  const getNavigationState = useCallback(() => {
   494	    const stageInfo = stageUtils.getStageInfo(currentStage);
   495	    return {
   496	      currentStage,
   497	      currentIndex: stageInfo.index,
   498	      canGoNext: stageInfo.canAdvance,
   499	      canGoPrev: stageInfo.canGoBack,
   500	      isFirstStage: stageInfo.isFirst,
   501	      isLastStage: stageInfo.isLast,
   502	      autoAdvanceEnabled: autoAdvanceEnabled.current,
   503	      isTransitioning: isTransitioning.current,
   504	      allStages: stageUtils.getAllStagesInfo(),
   505	    };
   506	  }, [currentStage]);
   507	
   508	  const getStageButtonData = useCallback(() => {
   509	    return MC3V_STAGE_ORDER.map(stageName => ({
   510	      id: stageName,
   511	      label: STAGE_METADATA.stageLabels[stageName],
   512	      isActive: stageName === currentStage,
   513	      isReached: stageReached.current[stageName],
   514	      onClick: () => jumpToStage(stageName),
   515	    }));
   516	  }, [currentStage, jumpToStage]);
   517	
   518	  // ✅ KEYBOARD NAVIGATION
   519	
   520	  useEffect(() => {
   521	    const handleKeyDown = event => {
   522	      let handled = false;
   523	
   524	      switch (event.key) {
   525	        case 'ArrowRight':
   526	        case ' ':
   527	        case 'Enter':
   528	          handled = nextStage();
   529	          break;
   530	
   531	        case 'ArrowLeft':
   532	          handled = prevStage();
   533	          break;
   534	
   535	        case 'Home':
   536	          handled = jumpToStage(STAGE_METADATA.firstStage);
   537	          break;
   538	
   539	        case 'End':
   540	          handled = jumpToStage(STAGE_METADATA.lastStage);
   541	          break;
   542	
   543	        case 'p':
   544	        case 'P':
   545	          if (event.ctrlKey || event.metaKey) {
   546	            toggleAutoAdvance(!autoAdvanceEnabled.current);
   547	            handled = true;
   548	          }
   549	          break;
   550	      }
   551	
   552	      // Development shortcuts
   553	      if (process.env.NODE_ENV === 'development') {
   554	        if (event.ctrlKey && event.key >= '0' && event.key <= '4') {
   555	          const targetIndex = parseInt(event.key);
   556	          const targetStage = stageUtils.indexToStage(targetIndex);
   557	          handled = jumpToStage(targetStage);
   558	          console.log(`🎮 Dev shortcut: Stage ${targetIndex} (${targetStage})`);
   559	        }
   560	
   561	        if (event.ctrlKey && event.key === 't') {
   562	          const snapshot = getNarrativeSnapshot();
   563	          console.log('📊 Navigation state:', getNavigationState());
   564	          console.log('📊 Narrative state:', snapshot);
   565	          handled = true;
   566	        }
   567	      }
   568	
   569	      if (handled) {
   570	        event.preventDefault();
   571	        event.stopPropagation();
   572	      }
   573	    };
   574	
   575	    window.addEventListener('keydown', handleKeyDown);
   576	    return () => window.removeEventListener('keydown', handleKeyDown);
   577	  }, [
   578	    nextStage,
   579	    prevStage,
   580	    jumpToStage,
   581	    toggleAutoAdvance,
   582	    getNavigationState,
   583	    getNarrativeSnapshot,
   584	  ]);
   585	
   586	  // ✅ INITIALIZATION & INTEGRITY CHECK
   587	
   588	  useEffect(() => {
   589	    console.log('🎭 Consolidated Navigation Controller: Initializing...');
   590	
   591	    // ✅ STAGE INTEGRITY CHECK
   592	    const isValid = validateStageIntegrity(NARRATIVE_PRESETS);
   593	    if (!isValid) {
   594	      console.error('❌ Stage integrity check failed - navigation may not work correctly');
   595	    }
   596	
   597	    // Initialize with first stage if not already set
   598	    if (!stageUtils.isValidStage(currentStage)) {
   599	      console.log(`🔧 Invalid current stage "${currentStage}", initializing to genesis`);
   600	      jumpToStage('genesis');
   601	    } else {
   602	      console.log(`✅ Navigation initialized at stage: ${currentStage}`);
   603	      stageStartTime.current = Date.now();
   604	      triggerStageEvents(currentStage);
   605	    }
   606	
   607	    return () => {
   608	      clearAutoAdvance();
   609	    };
   610	  }, [currentStage, jumpToStage, triggerStageEvents, clearAutoAdvance]);
   611	
   612	  // ✅ GLOBAL API EXPOSURE (For UI components and external systems)
   613	
   614	  useEffect(() => {
   615	    if (typeof window !== 'undefined') {
   616	      window.narrativeNavigation = {
   617	        // Core navigation
   618	        nextStage,
   619	        prevStage,
   620	        jumpToStage,
   621	
   622	        // Auto-advance
   623	        toggleAutoAdvance,
   624	        isAutoAdvanceEnabled: () => autoAdvanceEnabled.current,
   625	
   626	        // State queries
   627	        getCurrentStage: () => currentStage,
   628	        getNavigationState,
   629	        getStageButtonData,
   630	
   631	        // Utilities
   632	        canAdvance: () => stageUtils.canAdvance(currentStage),
   633	        canGoBack: () => stageUtils.canGoBack(currentStage),
   634	        getAllStages: () => MC3V_STAGE_ORDER,
   635	        getStageInfo: stage => stageUtils.getStageInfo(stage || currentStage),
   636	
   637	        // Debug
   638	        getDebugInfo: () => ({
   639	          currentStage,
   640	          stageIndex: stageUtils.stageToIndex(currentStage),
   641	          autoAdvance: autoAdvanceEnabled.current,
   642	          isTransitioning: isTransitioning.current,
   643	          stageReached: { ...stageReached.current },
   644	        }),
   645	      };
   646	    }
   647	
   648	    return () => {
   649	      if (typeof window !== 'undefined') {
   650	        delete window.narrativeNavigation;
   651	      }
   652	    };
   653	  }, [
   654	    currentStage,
   655	    nextStage,
   656	    prevStage,
   657	    jumpToStage,
   658	    toggleAutoAdvance,
   659	    getNavigationState,
   660	    getStageButtonData,
   661	  ]);
   662	
   663	  // This component doesn't render anything - pure logic
   664	  return null;
   665	}
   666	
   667	// ✅ EXPORT UTILITIES FOR EXTERNAL USE
   668	
   669	export const navigationUtils = {
   670	  // These will be overridden by the running controller
   671	  nextStage: () => console.warn('NavigationController not initialized'),
   672	  prevStage: () => console.warn('NavigationController not initialized'),
   673	  jumpToStage: () => console.warn('NavigationController not initialized'),
   674	
   675	  // Static utilities (always available)
   676	  stageOrder: MC3V_STAGE_ORDER,
   677	  stageLabels: STAGE_METADATA.stageLabels,
   678	  isValidStage: stageUtils.isValidStage,
   679	  getStageInfo: stageUtils.getStageInfo,
   680	  getAllStagesInfo: stageUtils.getAllStagesInfo,
   681	};
   682	// src/components/ui/NarrativeUIControls.jsx
   683	// 🎯 REPLACES StageNavigation.jsx - Uses ConsolidatedNavigationController API
   684	
   685	import { useState, useEffect } from 'react';
   686	
   687	export default function NarrativeUIControls() {
   688	  const [navState, setNavState] = useState(null);
   689	  const [stageButtons, setStageButtons] = useState([]);
   690	
   691	  // Subscribe to navigation state updates
   692	  useEffect(() => {
   693	    const updateNavState = () => {
   694	      if (window.narrativeNavigation) {
   695	        setNavState(window.narrativeNavigation.getNavigationState());
   696	        setStageButtons(window.narrativeNavigation.getStageButtonData());
   697	      }
   698	    };
   699	
   700	    // Initial update
   701	    updateNavState();
   702	
   703	    // Update on stage changes (listen to custom events or poll)
   704	    const interval = setInterval(updateNavState, 100); // Light polling
   705	
   706	    return () => clearInterval(interval);
   707	  }, []);
   708	
   709	  if (!navState) {
   710	    return (
   711	      <div
   712	        style={{
   713	          position: 'fixed',
   714	          top: '1rem',
   715	          right: '1rem',
   716	          color: '#666',
   717	          fontSize: '0.75rem',
   718	          zIndex: 22,
   719	        }}
   720	      >
   721	        Navigation loading...
   722	      </div>
   723	    );
   724	  }
   725	
   726	  return (
   727	    <div style={{ position: 'fixed', top: '1rem', right: '1rem', zIndex: 22 }}>
   728	      {/* Stage Buttons (replaces original StageNavigation) */}
   729	      <div style={{ marginBottom: '1rem' }}>
   730	        <div
   731	          style={{
   732	            color: 'white',
   733	            fontSize: '0.75rem',
   734	            marginBottom: '0.5rem',
   735	            opacity: 0.7,
   736	          }}
   737	        >
   738	          Digital Awakening Timeline
   739	        </div>
   740	        <ul
   741	          style={{
   742	            listStyle: 'none',
   743	            padding: 0,
   744	            margin: 0,
   745	            display: 'flex',
   746	            flexDirection: 'column',
   747	            gap: '0.25rem',
   748	          }}
   749	        >
   750	          {stageButtons.map(({ id, label, isActive, onClick }) => (
   751	            <li key={id}>
   752	              <button
   753	                onClick={onClick}
   754	                disabled={navState.isTransitioning}
   755	                style={{
   756	                  background: isActive ? '#0D9488' : 'transparent',
   757	                  border: '1px solid #0D9488',
   758	                  color: isActive ? '#fff' : '#0D9488',
   759	                  padding: '0.25rem 0.5rem',
   760	                  fontSize: '0.75rem',
   761	                  cursor: navState.isTransitioning ? 'not-allowed' : 'pointer',
   762	                  transition: 'all 0.2s',
   763	                  opacity: navState.isTransitioning ? 0.5 : 1,
   764	                  width: '100%',
   765	                  textAlign: 'left',
   766	                }}
   767	                onMouseEnter={e => {
   768	                  if (!isActive && !navState.isTransitioning) {
   769	                    e.target.style.background = 'rgba(13, 148, 136, 0.1)';
   770	                  }
   771	                }}
   772	                onMouseLeave={e => {
   773	                  if (!isActive) {
   774	                    e.target.style.background = 'transparent';
   775	                  }
   776	                }}
   777	              >
   778	                {label}
   779	              </button>
   780	            </li>
   781	          ))}
   782	        </ul>
   783	      </div>
   784	
   785	      {/* Navigation Controls */}
   786	      <div
   787	        style={{
   788	          display: 'flex',
   789	          flexDirection: 'column',
   790	          gap: '0.5rem',
   791	          marginBottom: '1rem',
   792	        }}
   793	      >
   794	        <div
   795	          style={{
   796	            display: 'flex',
   797	            gap: '0.25rem',
   798	          }}
   799	        >
   800	          <button
   801	            onClick={() => window.narrativeNavigation?.prevStage()}
   802	            disabled={!navState.canGoPrev || navState.isTransitioning}
   803	            style={{
   804	              background: 'rgba(255, 255, 255, 0.1)',
   805	              border: '1px solid rgba(255, 255, 255, 0.3)',
   806	              color: 'white',
   807	              padding: '0.25rem 0.5rem',
   808	              fontSize: '0.75rem',
   809	              cursor: navState.canGoPrev && !navState.isTransitioning ? 'pointer' : 'not-allowed',
   810	              opacity: navState.canGoPrev && !navState.isTransitioning ? 1 : 0.3,
   811	            }}
   812	          >
   813	            ← Prev
   814	          </button>
   815	
   816	          <button
   817	            onClick={() => window.narrativeNavigation?.nextStage()}
   818	            disabled={!navState.canGoNext || navState.isTransitioning}
   819	            style={{
   820	              background: 'rgba(255, 255, 255, 0.1)',
   821	              border: '1px solid rgba(255, 255, 255, 0.3)',
   822	              color: 'white',
   823	              padding: '0.25rem 0.5rem',
   824	              fontSize: '0.75rem',
   825	              cursor: navState.canGoNext && !navState.isTransitioning ? 'pointer' : 'not-allowed',
   826	              opacity: navState.canGoNext && !navState.isTransitioning ? 1 : 0.3,
   827	            }}
   828	          >
   829	            Next →
   830	          </button>
   831	        </div>
   832	
   833	        <button
   834	          onClick={() =>
   835	            window.narrativeNavigation?.toggleAutoAdvance(!navState.autoAdvanceEnabled)
   836	          }
   837	          style={{
   838	            background: navState.autoAdvanceEnabled ? '#0D9488' : 'transparent',
   839	            border: '1px solid #0D9488',
   840	            color: navState.autoAdvanceEnabled ? 'white' : '#0D9488',
   841	            padding: '0.25rem 0.5rem',
   842	            fontSize: '0.75rem',
   843	            cursor: 'pointer',
   844	            transition: 'all 0.2s',
   845	          }}
   846	        >
   847	          {navState.autoAdvanceEnabled ? '⏸️ Auto' : '▶️ Auto'}
   848	        </button>
   849	      </div>
   850	
   851	      {/* Stage Info */}
   852	      <div
   853	        style={{
   854	          color: 'rgba(255, 255, 255, 0.7)',
   855	          fontSize: '0.625rem',
   856	          textAlign: 'right',
   857	        }}
   858	      >
   859	        Stage {navState.currentIndex + 1} of {navState.allStages.length}
   860	        <br />
   861	        {navState.isTransitioning && 'Transitioning...'}
   862	      </div>
   863	
   864	      {/* Keyboard Shortcuts Help */}
   865	      <div
   866	        style={{
   867	          marginTop: '1rem',
   868	          padding: '0.5rem',
   869	          background: 'rgba(0, 0, 0, 0.3)',
   870	          borderRadius: '4px',
   871	          fontSize: '0.625rem',
   872	          color: 'rgba(255, 255, 255, 0.5)',
   873	          lineHeight: 1.3,
   874	        }}
   875	      >
   876	        <div style={{ fontWeight: 'bold', marginBottom: '0.25rem' }}>Keyboard:</div>
   877	        <div>→ / Space: Next</div>
   878	        <div>← : Previous</div>
   879	        <div>Ctrl+P: Auto-advance</div>
   880	        <div>Home/End: First/Last</div>
   881	      </div>
   882	    </div>
   883	  );
   884	}
