const CONSCIOUSNESS_STAGE_MAPPINGS = {
  genesis: {
    brainRegion: 'hippocampus',
    coordinates: HIPPOCAMPUS_COORDINATES,
    description: 'Memory formation genesis'
  },
  discipline: {
