-+
-+  calculateStageDurations() {
-+    const durations = {};
-+    Object.entries(TIMELINE).forEach(([stage, segments]) => {
-+      const lastSegment = segments[segments.length - 1];
-+      durations[stage] = lastSegment.at + lastSegment.dur + 2000; // 2s buffer
-+    });
-+    return durations;
-+  }
-+
-+  start(stage) {
-+    this.currentStage = stage;
-+    this.stageStartTime = Date.now();
-+    this.isPaused = false;
