  1266	
  1267	  getConsciousnessStageConfig(stageName, qualityTier = 'HIGH') {
  1268	    const stageIndex = CONSCIOUSNESS_STAGE_NAME_TO_INDEX[stageName] || 0;
  1269	    const baseConfig = CONSCIOUSNESS_THEATER_STAGES[stageIndex] || CONSCIOUSNESS_THEATER_STAGES[0];
  1270	    
  1271	    const qualityMultipliers = {
  1272	      ULTRA: { particles: 1.2, effects: 1.1, spacing: 1.0 },
  1273	      HIGH: { particles: 1.0, effects: 1.0, spacing: 1.0 },
  1274	      MEDIUM: { particles: 0.8, effects: 0.9, spacing: 0.9 },
  1275	      LOW: { particles: 0.6, effects: 0.8, spacing: 0.8 },
  1276	    };
  1277	
  1278	    const multiplier = qualityMultipliers[qualityTier] || qualityMultipliers.HIGH;
  1279	
  1280	    const particleCount = baseConfig.particlesShowcase && 
  1281	                         qualityTier === 'ULTRA' && 
  1282	                         stageName === 'transcendence' 
  1283	      ? baseConfig.particlesShowcase 
  1284	      : baseConfig.particles;
  1285	
  1286	    return {
  1287	      ...baseConfig,
  1288	      particles: Math.round(particleCount * multiplier.particles),
  1289	      stageIndex,
  1290	      stageName,
  1291	      qualityTier,
  1292	      constellation: {
  1293	        ...baseConfig.constellation,
  1294	        spacing: baseConfig.constellation.spacing * multiplier.spacing,
  1295	      },
  1296	      shaderEffects: {
  1297	        ...baseConfig.shaderEffects,
  1298	        livingAmplitude: baseConfig.shaderEffects.livingAmplitude * multiplier.effects,
  1299	        shimmerIntensity: baseConfig.shaderEffects.shimmerIntensity * multiplier.effects,
  1300	        pointScale: (baseConfig.shaderEffects.pointScale || this._calculatePointScale(stageName, qualityTier))
