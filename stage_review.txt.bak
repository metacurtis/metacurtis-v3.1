  1238	
  1239	  _calculatePointScale(stageName, qualityTier) {
  1240	    const baseScale = CONSTELLATION_CONSTANTS.POINT_SCALE_SYSTEM.BASE_SCALE;
  1241	    const stageMultiplier = CONSTELLATION_CONSTANTS.POINT_SCALE_SYSTEM.STAGE_MULTIPLIERS[stageName] || 1.0;
  1242	    const qualityMultiplier = CONSTELLATION_CONSTANTS.POINT_SCALE_SYSTEM.QUALITY_MULTIPLIERS[qualityTier] || 1.0;
  1243	    
  1244	    return baseScale * stageMultiplier * qualityMultiplier;
  1245	  }
  1246	
  1247	  _getConstellationScale(stageName) {
  1248	    const stageConfig = this.getConsciousnessStageConfig(stageName, 'HIGH');
  1249	    let scale = CONSTELLATION_CONSTANTS.BASE_CONSTELLATION_SCALE * 
  1250	                CONSTELLATION_CONSTANTS.VIEWPORT_COVERAGE;
  1251	
  1252	    if (stageName === 'velocity' || stageName === 'transcendence') {
  1253	      scale *= CONSTELLATION_CONSTANTS.COSMIC_SCALE_MULTIPLIER;
  1254	    }
  1255	
  1256	    const spacingType = stageConfig.constellation?.distribution || 'NORMAL';
  1257	    const spacingMultiplier = CONSTELLATION_CONSTANTS.DISTRIBUTION_SPACING[spacingType.toUpperCase()] || 1.0;
  1258	    scale *= spacingMultiplier;
  1259	
  1260	    return scale;
  1261	  }
