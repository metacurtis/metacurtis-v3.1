  1462	  }
  1463	
  1464	  generateBasicBrainCoordinates(stageName) {
  1465	    const coordinates = [];
  1466	    const pointCount = 150;
  1467	    
  1468	    switch (stageName) {
  1469	      case 'genesis':
  1470	        // Hippocampus C-curve
  1471	        for (let i = 0; i < pointCount; i++) {
  1472	          const t = (i / pointCount) * Math.PI * 1.3;
  1473	          const x = Math.cos(t) * 0.8;
  1474	          const y = Math.sin(t) * 0.6;
  1475	          const z = Math.sin(t * 1.5) * 0.2;
  1476	          coordinates.push(new THREE.Vector3(x, y, z));
  1477	        }
  1478	        break;
  1479	        
  1480	      case 'discipline':
  1481	        // Brainstem column
  1482	        for (let i = 0; i < pointCount; i++) {
  1483	          const t = i / pointCount;
  1484	          const x = (Math.random() - 0.5) * 0.2;
  1485	          const y = (-1.0 + t * 2.0);
  1486	          const z = (Math.random() - 0.5) * 0.1;
  1487	          coordinates.push(new THREE.Vector3(x, y, z));
  1488	        }
  1489	        break;
  1490	        
  1491	      default:
  1492	        // Default circular distribution
  1493	        for (let i = 0; i < pointCount; i++) {
  1494	          const angle = (i / pointCount) * Math.PI * 2;
  1495	          const radius = 0.6 + Math.random() * 0.4;
  1496	          const x = Math.cos(angle) * radius;
  1497	          const y = Math.sin(angle) * radius;
  1498	          const z = (Math.random() - 0.5) * 0.2;
  1499	          coordinates.push(new THREE.Vector3(x, y, z));
  1500	        }
  1501	    }
  1502	    
  1503	    return coordinates;
  1504	  }
