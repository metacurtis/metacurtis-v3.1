  1449	
  1450	  initializeBasicCoordinates() {
  1451	    const stages = ['genesis', 'discipline', 'neural', 'velocity', 'architecture', 'harmony', 'transcendence'];
  1452	    
  1453	    stages.forEach(stageName => {
  1454	      this.brainRegionCoordinatesCache[stageName] = this.generateBasicBrainCoordinates(stageName);
