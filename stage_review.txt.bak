  3024	/**
  3025	 * Maps numeric stage back to primary stage name
  3026	 * @param {number} numericStage - Numeric stage (0-5)
  3027	 * @returns {string} - Primary stage name
  3028	 */
  3029	export const mapNumericToStage = numericStage => {
  3030	  const clampedStage = Math.floor(Math.max(0, Math.min(CANONICAL_STAGES.length - 1, numericStage)));
  3031	  return indexToStage[clampedStage] || 'genesis';
  3032	};
  3033	
  3034	/**
  3035	 * Get complete stage configuration by name or index
  3036	 * @param {string|number} stage - Stage name or numeric index
  3037	 * @param {number} scrollProgress - Current scroll progress (0-1)
  3038	 * @returns {object} - Complete stage configuration
  3039	 */
  3040	export const getStageParticleConfig = (stage, scrollProgress = 0) => {
  3041	  const stageData =
  3042	    typeof stage === 'string'
  3043	      ? CANONICAL_STAGES.find(s => s.name === stage)
  3044	      : CANONICAL_STAGES[Math.floor(Math.max(0, Math.min(CANONICAL_STAGES.length - 1, stage)))];
  3045	
  3046	  if (!stageData) {
  3047	    console.warn(`[StageMappingUtils] Invalid stage: ${stage}, using genesis`);
  3048	    return { ...CANONICAL_STAGES[0], scrollProgress, stageProgress: 0 };
  3049	  }
  3050	
  3051	  return {
  3052	    numericStage: stageData.index,
  3053	    stageName: stageData.name,
  3054	    scrollProgress,
  3055	    stageProgress: (scrollProgress * CANONICAL_STAGES.length) % 1,
  3056	    ...stageData,
  3057	  };
  3058	};
