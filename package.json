{
  "name": "metacurtis-v3.1",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview --port=5000 --strictPort",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "fix:all": "npm run lint:fix && npm run format",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --reporter=html",
    "test:watch": "vitest watch",
    "lighthouse": "lhci autorun --config=./lighthouserc.json",
    "lighthouse:full": "npm run build && npm run lighthouse",
    "validate": "node scripts/validate-sst.js && node tools/sst-guard.mjs",
    "validate:sst": "node ./scripts/validate-sst-integration.js",
    "predev": "npm run validate",
    "prebuild": "npm run validate",
    "prepare": "husky",
    "fix": "node scripts/apply-fix.js",
    "fix:sst": "node scripts/apply-sst-v3-fixes.js",
    "doctor": "node scripts/render-contract-verify.cjs --fix && node scripts/snapshot-render-stack.cjs",
    "doctor:verify": "node scripts/render-contract-verify.cjs",
    "canon:level2": "node scripts/canon-level2.cjs",
    "canon:level2:verify": "node scripts/canon-console-verify.js",
    "canon:bridge:l2": "node scripts/canon-guard-l2-bridge.cjs",
    "canon:bridge:l2:verify": "node scripts/canon-console-verify.js",
    "canon:pilot:install": "node scripts/canon-pilot-install.cjs",
    "canon:pilot:verify": "node scripts/canon-pilot-verify.mjs",
    "guard:finish": "node scripts/finish-guard-console.cjs",
    "console:l2:finish": "node scripts/finish-guard-console.cjs",
    "hot-dors": "node scripts/hot-dors.v2.cjs",
    "sprint:start": "node scripts/sprintctl.cjs start",
    "sprint:snapshot": "node scripts/sprintctl.cjs snapshot",
    "sprint:stop": "node scripts/sprintctl.cjs stop",
    "sprint:status": "node scripts/sprintctl.cjs status",
    "sprint:note": "node scripts/sprintctl.cjs note",
    "doctor:render": "node scripts/render-doctor.v2.cjs",
    "doctor:perf": "node scripts/doctor-perf.cjs",
    "doctor:perf:strict": "node scripts/doctor-perf.cjs --strict-perf",
    "doctor:repo": "npm run validate && npm run doctor:perf",
    "evidence:rollup": "node scripts/evidence-rollup.cjs",
    "sst:verify": "node tools/sst-guard.mjs",
    "agent:run": "node scripts/agent/runner.mjs",
    "validate:opening": "node tools/sst-guard.mjs --opening",
    "validate:vision": "node tools/sst-guard.mjs --vision",
    "agent:visuals": "node scripts/agent/goals/visuals.mjs",
    "agent:record": "node scripts/agent/goals/record.mjs",
    "doctor:agents": "node scripts/doctor.catalog-agents-sentinels.mjs --write",
    "opening:check": "node tools/sst-guard.mjs --opening --vision && node scripts/agent/runner.mjs --goal=opening:visuals",
    "canon:verify": "node scripts/canon-console-verify.mjs",
    "ci:fencepost": "node scripts/ci/opening-fencepost-check.mjs",
    "devos:verify": "node scripts/ci/opening-fencepost-check.mjs || true",
    "validate:single-writer": "grep -r 'setAttribute\\|setDrawRange\\|material\\.uniforms' src --include='*.js' --include='*.jsx' | grep -v 'WebGL' && echo '⛔ GPU writes outside renderer' && exit 1 || echo '✅ Single-writer clean'"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "gsap": "^3.13.0",
    "lucide-react": "^0.511.0",
    "opentype.js": "^1.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "seedrandom": "^3.0.5",
    "svgo": "^4.0.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.3",
    "@babel/parser": "^7.28.3",
    "@babel/traverse": "^7.28.3",
    "@babel/types": "^7.28.2",
    "@eslint/js": "^9.24.0",
    "@lhci/cli": "^0.12.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@tailwindcss/vite": "^4.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.6.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-glob": "^3.3.3",
    "globals": "^16.0.0",
    "husky": "^8.0.3",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.2.7",
    "playwright": "^1.55.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.7",
    "terser": "^5.39.0",
    "vite": "^6.2.5",
    "vite-plugin-glsl": "^1.4.0",
    "vitest": "^1.4.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "src/**/*.{css,md,json}": [
      "prettier --write"
    ]
  }
}