{
  "root": true,

  /* ------------------------------------------------- ignore build artefacts */
  "ignorePatterns": ["dist/", "node_modules/"],

  /* ----------------------------------------------------------- environments */
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },

  /* ------------------------------------------------------- shared rule‑sets */
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended"
    /* add other extends you need… */
  ],

  /* ------------------------------------------------ custom parsers/options */
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },

  /* ------------------------------------------------------- extra plug‑ins  */
  "plugins": [
    "react",
    "unused-imports"
  ],

  /* ----------------------------------------------------------- react hints  */
  "settings": {
    "react": {
      "version": "detect"
    }
  },

  /* --------------------------------------------------------- project rules  */
  "rules": {
    /* ---------- unused‑imports ------------------------------------------------ */

    // remove unused `import` lines (‑‑fix will delete them automatically)
    "unused-imports/no-unused-imports": "error",

    // replace core rule so we can allow identifiers/args prefixed with "_"
    "no-unused-vars": "off",
    "unused-imports/no-unused-vars": [
      "error",
      {
        "vars": "all",
        "varsIgnorePattern": "^_",        // ignore const _foo
        "args": "after-used",
        "argsIgnorePattern": "^_"         // ignore function(_err)
      }
    ]

    /* ---------- add any project‑specific overrides below -------------------- */
  }
}
