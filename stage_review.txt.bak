  2909	export function BackgroundPoints({ count = 8000, size = 5, color = '#ffffff' }) {
  2910	  const geometry = useMemo(() => {
  2911	    const positions = new Float32Array(count * 3);
  2912	    const half = 10;
  2913	    for (let i = 0; i < count; i++) {
  2914	      const i3 = i * 3;
  2915	      positions[i3] = (Math.random() * 2 - 1) * half;
  2916	      positions[i3 + 1] = (Math.random() * 2 - 1) * half;
  2917	      positions[i3 + 2] = (Math.random() * 2 - 1) * half;
  2918	    }
  2919	    const geo = new THREE.BufferGeometry();
  2920	    geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  2921	    return geo;
  2922	  }, [count]);
  2923	
  2924	  return (
  2925	    <points geometry={geometry}>
  2926	      <pointsMaterial attach="material" size={size} color={color} depthWrite={false} transparent />
  2927	    </points>
  2928	  );
  2929	}
