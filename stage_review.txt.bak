  2164	// ✅ PRESERVED: Scroll binding utility
  2165	export const createScrollBinding = () => {
  2166	  let ticking = false;
  2167	
  2168	  const handleScroll = () => {
  2169	    if (!ticking) {
  2170	      requestAnimationFrame(() => {
  2171	        const scrollY = window.pageYOffset || document.documentElement.scrollTop;
  2172	        const maxScroll = Math.max(
  2173	          document.body.scrollHeight - window.innerHeight,
  2174	          document.documentElement.scrollHeight - window.innerHeight,
  2175	          1
  2176	        );
  2177	
  2178	        const globalProgress = Math.min(scrollY / maxScroll, 1);
  2179	        useNarrativeStore.getState().setGlobalProgress(globalProgress);
  2180	
  2181	        ticking = false;
  2182	      });
  2183	      ticking = true;
  2184	    }
  2185	  };
  2186	
  2187	  window.addEventListener('scroll', handleScroll, { passive: true });
  2188	
  2189	  return () => {
  2190	    window.removeEventListener('scroll', handleScroll);
  2191	  };
  2192	};
