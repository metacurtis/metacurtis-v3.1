import { useRef, useEffect } from 'react';
import { useCentralClock } from '@/hooks/useCentralClock';
import AdaptiveQualitySystem, { QualityLevels } from '@/utils/performance/AdaptiveQualitySystem.js';
import usePerformanceStore from '@/stores/performanceStore.js';

// ✅ SAFETY: Runtime guard for atomic imports
let clockAtom = null;
try {
  // Dynamic import with fallback for when atomic stores aren't available
  const atomicModule = await import('@/stores/atoms/clockAtom.js').catch(() => null);
  clockAtom = atomicModule?.clockAtom || null;
} catch {
  // Atomic stores not available - will fall back to legacy mode
  clockAtom = null;
}

/**
 * ✅ PRODUCTION-READY: Adaptive quality hook with comprehensive safety measures
 * @param {Object} options - Configuration options
 * @param {number} options.windowSize - FPS sampling window size
 * @param {number} options.ultraFps - Ultra quality FPS threshold  
 * @param {number} options.highFps - High quality FPS threshold
 * @param {number} options.mediumFps - Medium quality FPS threshold
 * @param {string} options.initial - Initial quality level
 * @returns {string} Current quality tier
 */
export function useAdaptiveQuality({
  windowSize = 60,
  ultraFps = 65,
  highFps = 55,
  mediumFps = 45,
  initial = QualityLevels.HIGH,
} = {}) {
  // ✅ ENHANCED: Store setter only, no direct FPS calculation
  const setQuality = usePerformanceStore(state => state.setQuality);

  const aqsRef = useRef(null);
  const lastUpdateTime = useRef(0);
  const unsubscribeRef = useRef(null);

  // ✅ ENHANCED: Initialize AQS once with proper configuration
  if (!aqsRef.current) {
    aqsRef.current = new AdaptiveQualitySystem({
      windowSize,
      ultraFps,
      highFps,
      mediumFps,
      initial,
    });
    
    if (import.meta.env.DEV) { // ✅ FIX: Vite-specific dev check
      console.log('🔧 P0-1 Enhanced: useAdaptiveQuality initialized with config:', {
        windowSize, ultraFps, highFps, mediumFps, initial
      });
    }
  }

  // ✅ ENHANCED: Dynamic throttle calculation based on refresh rate
  const calculateThrottleInterval = () => {
    // Get target FPS from central clock or fallback
    let targetFps = 60;
    if (clockAtom?.getState) {
      try {
        const clockState = clockAtom.getState();
        targetFps = clockState.targetFps || 60;
      } catch {
        // Fallback if clockAtom access fails
        targetFps = 60;
      }
    }
    
    // Sample at ~10 Hz relative to display refresh rate
    return 1000 / Math.min(targetFps / 6, 15); // Max 15 Hz, min based on target FPS
  };

  // ✅ ENHANCED: Central Clock integration with comprehensive fallback
  const handleClockTick = (frameTime) => {
    // ✅ FIX: Dynamic throttle calculation
    const throttleInterval = calculateThrottleInterval();
    if (frameTime - lastUpdateTime.current < throttleInterval) return;
    lastUpdateTime.current = frameTime;
    
    let currentFps = 0;
    
    // ✅ SAFETY: Multiple FPS source fallback chain
    if (clockAtom?.getState) {
      try {
        const clockState = clockAtom.getState();
        currentFps = clockState.fps || 0;
      } catch (error) {
        if (import.meta.env.DEV) {
          console.warn('[AQS] Central clock FPS access failed, using performance store fallback:', error);
        }
        // Fallback to performance store
        currentFps = usePerformanceStore.getState().fps || 0;
      }
    } else {
      // ✅ SAFETY: Legacy fallback when atomic stores unavailable
      if (import.meta.env.DEV) {
        console.warn('[AQS] Central clock FPS unavailable – falling back to performance store');
      }
      currentFps = usePerformanceStore.getState().fps || 0;
    }
    
    // Only update AQS if we have valid FPS data
    if (currentFps > 0) {
      const aqs = aqsRef.current;
      
      // ✅ FIX: Capture previous level before update
      const prevLevel = aqs.currentLevel;
      const nextLevel = aqs.updateWithExternalFps(currentFps);
      
      // ✅ FIX: Correct comparison logic
      if (prevLevel !== nextLevel) {
        setQuality(nextLevel);
        
        if (import.meta.env.DEV) {
          console.log(`🎯 Quality updated: ${prevLevel} → ${nextLevel} (FPS: ${currentFps.toFixed(1)})`);
        }
      }
    } else if (import.meta.env.DEV) {
      console.warn('[AQS] Invalid FPS data received:', currentFps);
    }
  };

  // ✅ ENHANCED: Central Clock integration with proper cleanup
  useEffect(() => {
    // ✅ FIX: Empty dependency array to prevent re-subscriptions
    const unsubscribe = useCentralClock('tick', handleClockTick, []);
    unsubscribeRef.current = unsubscribe;
    
    if (import.meta.env.DEV) {
      console.log('🔗 P0-1 Enhanced: Central Clock subscription established');
    }
    
    // ✅ FIX: Proper cleanup on unmount
    return () => {
      if (typeof unsubscribe === 'function') {
        unsubscribe();
      }
      unsubscribeRef.current = null;
    };
  }, []); // ✅ FIX: Empty deps array prevents re-subscriptions

  // ✅ FIX: Post-commit quality seeding to avoid render phase side effects
  useEffect(() => {
    if (aqsRef.current) {
      setQuality(aqsRef.current.currentLevel);
    }
  }, []); // Run once after mount

  // ✅ CLEANUP: Component unmount protection
  useEffect(() => {
    return () => {
      // Cleanup AQS if needed
      if (aqsRef.current?.destroy) {
        aqsRef.current.destroy();
      }
    };
  }, []);

  // ✅ ENHANCED: Return current quality from store
  return usePerformanceStore(state => state.quality);
}

/**
 * ✅ ENHANCED: Semantic alias for better call-site readability
 * @param {Object} options - Same as useAdaptiveQuality
 * @returns {string} Current quality tier
 */
export function useQualityTier(options) {
  return useAdaptiveQuality(options);
}

/**
 * ✅ ENHANCED: Development utilities for debugging
 */
export function useAdaptiveQualityDebug() {
  if (import.meta.env.DEV) {
    return {
      getAQSState: () => {
        // Access via module-level ref or store
        return {
          clockAtomAvailable: !!clockAtom?.getState,
          currentThrottleInterval: 1000 / Math.min(60 / 6, 15), // Approximate
          fallbackMode: !clockAtom?.getState
        };
      },
      getConfig: () => {
        // Return current configuration
        return {
          source: clockAtom?.getState ? 'Central Clock' : 'Performance Store',
          throttling: 'Dynamic based on refresh rate',
          safety: 'Multi-tier fallback enabled'
        };
      }
    };
  }
  return null;
}

// ✅ SAFETY: Runtime availability check for consuming components
export function isAdaptiveQualityAvailable() {
  try {
    return !!(usePerformanceStore && (clockAtom?.getState || usePerformanceStore.getState));
  } catch {
    return false;
  }
}

// ✅ DEVELOPMENT: Global debug access
if (import.meta.env.DEV && typeof window !== 'undefined') {
  window.useAdaptiveQualityDebug = useAdaptiveQualityDebug;
  window.isAdaptiveQualityAvailable = isAdaptiveQualityAvailable;
  
  // Check atomic availability
  window.checkAtomicAvailability = () => {
    return {
      clockAtom: !!clockAtom?.getState,
      performanceStore: !!usePerformanceStore?.getState,
      centralClock: !!useCentralClock,
      recommended: clockAtom?.getState ? 'Atomic mode' : 'Legacy mode'
    };
  };
}

// Export default as the main hook
