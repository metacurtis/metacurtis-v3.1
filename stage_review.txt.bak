  3008	/**
  3009	 * Maps narrative stage strings to numeric values for shader uniforms
  3010	 * @param {string} stageName - Stage name from performanceStore.narrative.currentStage
  3011	 * @returns {number} - Numeric stage (0-5) for shader uniforms
  3012	 */
  3013	export const mapStageToNumeric = stageName => {
  3014	  const numericStage = stageToIndex[stageName];
  3015	
  3016	  if (numericStage === undefined) {
  3017	    console.warn(`[StageMappingUtils] Unknown stage "${stageName}", defaulting to 0`);
  3018	    return 0;
  3019	  }
  3020	
  3021	  return numericStage;
  3022	};
