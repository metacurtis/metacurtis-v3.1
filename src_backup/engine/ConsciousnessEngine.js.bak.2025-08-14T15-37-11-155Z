import { Canonical } from '@/config/canonical/canonicalAuthority';
// src/engine/ConsciousnessEngine.js
// COMPLETE VERSION with stage colors from SST v3.0

import BeatBus from '@modules/orchestration/core/BeatBus';
import { EVENTS } from '@theater/events.js';

class ConsciousnessEngine {
  constructor() {
    this.currentStage = 'genesis';
    this._blueprintVersion = 0;
    this.currentQuality = 'HIGH';
    this.blueprintCache = new Map();
    this.currentBlueprint = null;
    this.lastStageBlueprint = null;
    this.emergenceScale = 1.0;
    
    // Stage-specific colors from SST v3.0 - AS HEX STRINGS!
    this.STAGE_COLORS = {
      genesis: { current: '#00ff00', next: '#22c55e' },
      discipline: { current: '#1e40af', next: '#3b82f6' },
      neural: { current: '#4338ca', next: '#a855f7' },
      velocity: { current: '#7c3aed', next: '#9333ea' },
      architecture: { current: '#0891b2', next: '#06b6d4' },
      harmony: { current: '#f59e0b', next: '#d97706' },
      transcendence: { current: '#ffffff', next: '#00ffcc' }
    };
    
    this.initializeBeatBusListeners();
    console.log('🧠 ConsciousnessEngine initialized with SST v3.0 tier system');
  }

  initializeBeatBusListeners() {
    // Listen to Director
    BeatBus.on(EVENTS.BUILD_EMERGENCE_BLUEPRINT, (opts = {}) => {
      console.log('🧠 Engine: Building emergence blueprint');
      const bp = this.buildCompleteEmergenceBlueprint(opts);
      this.emitReadyBlueprint(bp);
    });

    BeatBus.on(EVENTS.STAGE_CHANGE, ({ stage }) => {
      console.log(`🧠 Engine: Stage change to ${stage}`);
      this.currentStage = stage;
      const cacheKey = `${stage}|${this.currentQuality}`;
      this.blueprintCache.delete(cacheKey);
      const bp = this.buildCompleteStageBlueprint(stage, this.currentQuality);
      this.emitReadyBlueprint(bp);
    });

    BeatBus.on(EVENTS.QUALITY_CHANGE, ({ quality }) => {
      console.log(`🧠 Engine: Quality change to ${quality}`);
      this.currentQuality = quality;
      const bp = this.buildCompleteStageBlueprint(this.currentStage, quality);
      this.emitReadyBlueprint(bp);
    });

    BeatBus.on(EVENTS.PREWARM_GENESIS_BLUEPRINT, () => {
      console.log('🧠 Engine: Prewarming genesis blueprint');
      try {
        const bp = this.buildCompleteStageBlueprint('genesis', 'HIGH');
        this.blueprintCache.set('genesis|HIGH', bp);
        BeatBus.emit(EVENTS.PREWARM_COMPLETE, { ok: true, key: 'genesis|HIGH' });
      } catch (e) {
        console.warn('⚠️ Prewarm failed:', e);
        BeatBus.emit(EVENTS.PREWARM_COMPLETE, { ok: false, error: String(e) });
      }
    });

    // Initial blueprint - wait for listeners
    setTimeout(async () => {
      await this.waitForListeners(EVENTS.BLUEPRINT_READY, 1, 1500);
      console.log('🧠 Engine: Building initial blueprint');
      const bp = this.buildCompleteStageBlueprint(this.currentStage, this.currentQuality);
      this.emitReadyBlueprint(bp);
    }, 0);
  }

  // Add this helper: pick a valid particle count with fallbacks
  resolveParticleCount(stage, quality = 'HIGH') {
    const cfg = (globalThis.Canonical?.stages?.[stage]) || {};
    const p = cfg.particleCount ?? cfg.particles ?? cfg.count;
    if (Number.isFinite(p) && p > 0) return p;
    // fallback to your existing quality-based calculator
    return this.getParticleCount(stage, (quality || 'HIGH').toUpperCase());
  }

  // Safe default position generators (so calls never explode)
  generateAtmosphericPositions(count, radius = 24) {
    const pos = new Float32Array((count|0) * 3);
    for (let i = 0; i < count; i++) {
      const j = i * 3;
      const a = Math.random() * Math.PI * 2;
      const r = Math.sqrt(Math.random()) * radius;
      pos[j]     = Math.cos(a) * r;
      pos[j + 1] = Math.sin(a) * r;
      pos[j + 2] = (Math.random() - 0.5) * 6;
    }
    return pos;
  }

  generateBrainPositions(count, _region = 'sphere', radius = this.getStageRadius(this.currentStage)) {
    const pos = new Float32Array((count|0) * 3);
    for (let i = 0; i < count; i++) {
      const j = i * 3;
      const theta = Math.random() * 2 * Math.PI;
      const u = Math.random() * 2 - 1;
      const phi = Math.acos(u);
      const r = radius + Math.random() * 10;
      pos[j]     = r * Math.sin(phi) * Math.cos(theta);
      pos[j + 1] = r * Math.sin(phi) * Math.sin(theta);
      pos[j + 2] = r * Math.cos(phi);
    }
    return pos;
  }

  // Small utility: wait until at least one listener exists for an event
  async waitForListeners(eventName, min = 1, timeout = 2000) {
    const start = performance.now();
    while (performance.now() - start < timeout) {
      const map = window.beatBusDebug?.getListenerMap?.() || {};
      const n = Array.isArray(map[eventName]) ? map[eventName].length : 0;
      if (n >= min) return true;
      await new Promise(r => setTimeout(r, 50));
    }
    return false;
  }

  /**
   * BUILD COMPLETE STAGE BLUEPRINT - WITH COLORS!
   */
  buildCompleteStageBlueprint(stage, quality = 'HIGH') {
    const particleCount = this.resolveParticleCount(stage, quality);
    const radius = this.getStageRadius(stage);

    const atmosphericPositions = this.generateAtmosphericPositions(particleCount, radius);
    const allenAtlasPositions  = this.generateBrainPositions(particleCount, /*region*/'sphere', radius);

    // Fit to the viewport (now these arrays are non-empty)
    const w = window.innerWidth || 1920;
    const h = window.innerHeight || 1080;
    this.fitBlueprintToViewport(atmosphericPositions, w, h, 0.08);
    this.fitBlueprintToViewport(allenAtlasPositions, w, h, 0.08);

    // Simple tier distribution (50/20/15/15)
    const tierData = new Float32Array(particleCount);
    for (let i = 0; i < particleCount; i++) {
      const r = Math.random();
      tierData[i] = r > 0.85 ? 3 : r > 0.7 ? 2 : r > 0.5 ? 1 : 0;
    }

    const colors = this.STAGE_COLORS[stage] || { current: '#ffffff', next: '#888888' };

    const blueprint = {
      stage,
      particleCount,
      activeCount: particleCount,
      atmosphericPositions,
      allenAtlasPositions,
      positions: atmosphericPositions, // default
      tierData,
      colors,
      radius,
      timestamp: Date.now()
    };

    this.currentBlueprint = blueprint;
    console.log(`✅ Blueprint complete: ${particleCount} particles with tier distribution`);
    return blueprint;
  }

  // Fit blueprint to viewport (fix the blob!)
  fitBlueprintToViewport(positions, width, height, margin = 0.08) {
    // Find current bounds
    let minX = Infinity, maxX = -Infinity;
    let minY = Infinity, maxY = -Infinity;
    
    for (let i = 0; i < positions.length; i += 3) {
      const x = positions[i];
      const y = positions[i + 1];
      if (x < minX) minX = x;
      if (x > maxX) maxX = x;
      if (y < minY) minY = y;
      if (y > maxY) maxY = y;
    }
    
    const cx = (minX + maxX) / 2;
    const cy = (minY + maxY) / 2;
    const bw = Math.max(1e-6, maxX - minX);
    const bh = Math.max(1e-6, maxY - minY);
    
    // Scale to viewport with margin
    const aspect = width / height;
    const sx = 2 * (1 - margin) / bw * aspect;
    const sy = 2 * (1 - margin) / bh;
    const scale = Math.min(sx, sy) * 100; // Scale up for visibility
    
    // Apply scaling and centering
    for (let i = 0; i < positions.length; i += 3) {
      positions[i] = (positions[i] - cx) * scale;     // x
      positions[i + 1] = (positions[i + 1] - cy) * scale; // y
      // z stays the same for depth
    }
    
    console.log(`📐 Fitted ${positions.length/3} particles to viewport ${width}x${height}`);
  }

  /**
   * Parse hex color to RGB
   */
  parseHexColor(hex, target) {
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    if (result) {
      target.r = parseInt(result[1], 16) / 255;
      target.g = parseInt(result[2], 16) / 255;
      target.b = parseInt(result[3], 16) / 255;
    }
    target.hex = hex;
  }

  /**
   * BUILD COMPLETE EMERGENCE BLUEPRINT - WITH GENESIS COLORS
   */
  buildCompleteEmergenceBlueprint({ sourceText = 'HELLO CURTIS', count = 2000 } = {}) {
    console.log(`🌟 Building emergence blueprint from "${sourceText}"`);
    
    // Emergence always starts with genesis colors
    const stageColorConfig = this.STAGE_COLORS.genesis;
    
    const blueprint = {
      id: `emergence-${Date.now()}`,
      type: 'emergence',
      stageName: 'genesis',
      stageIndex: 0,
      particleCount: count,
      activeCount: count,
      
      // Genesis colors for emergence
      colorCurrent: { r: 0, g: 0, b: 0, hex: stageColorConfig.current },
      colorNext: { r: 0, g: 0, b: 0, hex: stageColorConfig.next },
      
      // Start positions (text shape)
      atmosphericPositions: this.textToParticlePositions(sourceText, count),
      
      // Target positions (use cached or create)
      allenAtlasPositions: this.getEmergenceTargetPositions(count),
      
      // All other arrays
      animationSeeds: new Float32Array(count * 3),
      sizeMultipliers: new Float32Array(count),
      opacityData: new Float32Array(count),
      atlasIndices: new Float32Array(count),
      tierData: new Float32Array(count),
      particleIndices: new Float32Array(count),
      
      // Pre-scaled for viewport
      scale: this.emergenceScale,
      
      ready: true,
      needsProcessing: false,
      version: ++this._blueprintVersion
    };

    // Parse colors
    this.parseHexColor(stageColorConfig.current, blueprint.colorCurrent);
    this.parseHexColor(stageColorConfig.next, blueprint.colorNext);

    // Fill arrays
    this.fillEmergenceArrays(blueprint, count);
    
    // Apply emergence scale to positions
    this.scalePositions(blueprint.atmosphericPositions, this.emergenceScale);
    
    return blueprint;
  }

  /**
   * Get target positions for emergence
   */
  getEmergenceTargetPositions(count) {
    // Use cached stage positions if available
    if (this.lastStageBlueprint?.allenAtlasPositions) {
      const cached = this.lastStageBlueprint.allenAtlasPositions;
      const result = new Float32Array(count * 3);
      const srcCount = cached.length / 3;
      
      for (let i = 0; i < count; i++) {
        const si = (i % srcCount) * 3;
        const di = i * 3;
        result[di] = cached[si];
        result[di + 1] = cached[si + 1];
        result[di + 2] = cached[si + 2];
      }
      return result;
    }
    
    // Fallback: Create sphere
    return this.createSpherePositions(count, 26);
  }

  /**
   * CREATE SPHERE POSITIONS
   */
  createSpherePositions(count, radius) {
    const positions = new Float32Array(count * 3);
    
    for (let i = 0; i < count; i++) {
      const idx = i * 3;
      
      // Random point on sphere
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(Math.random() * 2 - 1);
      const r = radius + Math.random() * 10;
      
      positions[idx] = r * Math.sin(phi) * Math.cos(theta);
      positions[idx + 1] = r * Math.sin(phi) * Math.sin(theta);
      positions[idx + 2] = r * Math.cos(phi);
    }
    
    return positions;
  }

  /**
   * FILL EMERGENCE ARRAYS
   */
  fillEmergenceArrays(blueprint, count) {
    for (let i = 0; i < count; i++) {
      const idx = i * 3;
      
      // Animation seeds
      blueprint.animationSeeds[idx] = Math.random();
      blueprint.animationSeeds[idx + 1] = Math.random();
      blueprint.animationSeeds[idx + 2] = Math.random();
      
      // Tier assignment (60/20/10/10 for emergence)
      const r = Math.random();
      let tier = 0;
      if (r > 0.6) tier = 1;
      if (r > 0.8) tier = 2;
      if (r > 0.9) tier = 3;
      
      blueprint.tierData[i] = tier;
      
      // Tier-based properties
      const tierConfigs = [
        { size: [0.5, 0.7], opacity: [0.3, 0.7], sprite: 7 },
        { size: [0.7, 0.9], opacity: [0.5, 0.8], sprite: 1 },
        { size: [1.0, 1.3], opacity: [0.7, 0.9], sprite: 4 },
        { size: [1.3, 2.0], opacity: [0.8, 1.0], sprite: 1 }
      ];
      
      const config = tierConfigs[tier];
      const [sMin, sMax] = config.size;
      const [oMin, oMax] = config.opacity;
      
      blueprint.sizeMultipliers[i] = sMin + Math.random() * (sMax - sMin);
      blueprint.opacityData[i] = oMin + Math.random() * (oMax - oMin);
      blueprint.atlasIndices[i] = config.sprite;
      blueprint.particleIndices[i] = i;
    }
  }

  /**
   * TEXT TO PARTICLE POSITIONS
   */
  textToParticlePositions(text, count) {
    const positions = new Float32Array(count * 3);
    const charWidth = 10.0;
    const textHeight = 12.0;
    
    for (let i = 0; i < count; i++) {
      const charIndex = Math.floor(Math.random() * text.length);
      const baseX = (charIndex - text.length / 2) * charWidth;
      positions[i * 3] = baseX + (Math.random() - 0.5) * charWidth * 0.8;
      positions[i * 3 + 1] = (Math.random() - 0.5) * textHeight;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 2.0;
    }
    
    return positions;
  }

  /**
   * SCALE POSITIONS
   */
  scalePositions(positions, scale) {
    for (let i = 0; i < positions.length; i++) {
      positions[i] *= scale;
    }
  }

  /**
   * Get particle count for stage/quality
   */
  getParticleCount(stage, quality) {
    const base = {
      genesis: 2000,
      discipline: 3000,
      neural: 5000,
      velocity: 12000,
      architecture: 8000,
      harmony: 12000,
      transcendence: 15000
    }[stage] || 2000;
    
    const multiplier = {
      LOW: 0.3,
      MEDIUM: 0.6,
      HIGH: 1.0,
      ULTRA: 1.5
    }[quality] || 1.0;
    
    return Math.min(Math.floor(base * multiplier), 15000);
  }

  /**
   * Get stage radius
   */
  getStageRadius(stage) {
    return {
      genesis: 26,
      discipline: 18,
      neural: 28,
      architecture: 30,
      velocity: 34,
      harmony: 36,
      transcendence: 42
    }[stage] || 26;
  }

  /**
   * Update emergence scale
   */
  updateEmergenceScale(camera) {
    if (!camera) {
      this.emergenceScale = 4.0; // Default scale
      return;
    }
    
    const fovRad = (camera.fov * Math.PI) / 180;
    const z = camera.position?.z || 80;
    const viewH = 2 * z * Math.tan(fovRad / 2);
    const desiredH = viewH * 0.65;
    const textH = 10.0;
    
    this.emergenceScale = desiredH / textH;
  }

  /**
   * Calculate tier counts
   */
  calculateTierCounts(total) {
    return [
      Math.floor(total * 0.50),
      Math.floor(total * 0.20),
      Math.floor(total * 0.15),
      Math.ceil(total * 0.15)
    ];
  }

  /**
   * Get tier behaviors if method exists
   */
  getTierBehaviors(stage) {
    return {
      tier1: { drift: 0.2, opacity: [0.3, 0.6], size: 0.6 },
      tier2: { orbital: 0.05, opacity: [0.4, 0.7], size: 0.8 },
      tier3: { twinkle: 0.03, opacity: [0.6, 0.8], size: 1.2 },
      tier4: { pulse: 0.01, opacity: [0.8, 1.0], size: 1.5 }
    };
  }

  /**
   * Emit blueprint
   */
  emitReadyBlueprint(blueprint) {
    // Canon Console L2: ensure renderer always has a positions buffer
    if (!blueprint.positions) {
      blueprint.positions = blueprint.atmosphericPositions || blueprint.allenAtlasPositions;
    }

    this.currentBlueprint = blueprint;
    
    BeatBus.emit(EVENTS.BLUEPRINT_READY, {
      blueprint: blueprint,
      ready: true,
      timestamp: Date.now()
    });
    
    // Emit emerged for emergence blueprints
    if (blueprint.type === 'emergence') {
      setTimeout(() => BeatBus.emit(EVENTS.PARTICLES_EMERGED), 1200);
    }
  }
}

// Singleton
const engine = new ConsciousnessEngine();

// Debug interface
if (typeof window !== 'undefined') {
  window.engineDebug = {
    getCacheStats: () => ({
      size: engine.blueprintCache.size,
      keys: Array.from(engine.blueprintCache.keys())
    }),
    clearCache: () => engine.blueprintCache.clear(),
    getCurrentBlueprint: () => engine.currentBlueprint,
    testBlueprint: () => {
      const bp = engine.buildCompleteStageBlueprint('genesis', 'HIGH');
      console.log('Test blueprint:', bp);
      return bp;
    },
    engine: engine // Direct access for debugging
  };
}

export default engine;