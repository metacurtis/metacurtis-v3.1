// consciousness-fragment.glsl
// SST v3.0 COMPLIANT - Complete fragment shader for MetaCurtis v3.1

precision mediump float;

// === UNIFORMS (Must match WebGLBackground.jsx) ===
// Atlas
uniform sampler2D uAtlasTexture;
uniform float uTotalSprites;

// Time & morph
uniform float uTime;
uniform float uMorphProgress;
uniform float uScrollProgress;
uniform float uStageProgress;
uniform float uStageBlend;

// Colors
uniform vec3 uColorCurrent;
uniform vec3 uColorNext;
uniform vec3 uColorAccent1;
uniform vec3 uColorAccent2;

// Tier & fade
uniform float uActiveCount;
uniform float uTierCutoff;
uniform float uFadeProgress;
uniform float uGaussianSigma;
uniform float uTierHighlight[4];

// Feature toggles
uniform float uGaussianFalloff;
uniform float uCenterWeighting;

// Stage meta
uniform float uStageIndex;
uniform float uBrainRegion;

// === VARYINGS (From vertex shader) ===
varying float vBlend;
varying float vAlpha;
varying vec2 vAtlasUVOffset;
varying float vTierID;
varying float vSizeMultiplier;
varying float vParticleIndex;

// === HELPER FUNCTIONS ===
float gaussianFalloff(vec2 coord, float sigma) {
    // coord is gl_PointCoord in [0,1]^2
    vec2 c = coord - 0.5;
    float d = dot(c, c);  // r^2
    // Higher sigma = softer edge (2.0-4.0 looks good)
    return exp(-d * sigma * sigma * 4.0);
}

vec3 rgb2hsv(vec3 c) {
    vec4 K = vec4(0.0, -1.0/3.0, 2.0/3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c) {
    vec3 p = abs(fract(c.xxx + vec3(0.0, 2.0/3.0, 1.0/3.0)) * 6.0 - 3.0);
    return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

vec4 sampleAtlasTexture(vec2 uvOffset, vec2 pointCoord) {
    // 4×4 grid (16 sprites)
    float spriteSize = 0.25;
    vec2 uv = uvOffset + pointCoord * spriteSize;
    return texture2D(uAtlasTexture, uv);
}

float shimmer(vec2 coord, float time, float tier) {
    // Tier-specific shimmer effects
    if (tier < 0.5) {
        // Tier 0: Gentle drift shimmer
        return 1.0 + sin(coord.x * 4.0 + time * 1.0) * 0.03;
    } else if (tier < 1.5) {
        // Tier 1: Orbital shimmer
        return 1.0 + sin(coord.y * 3.0 + time * 0.8) * 0.04;
    } else if (tier < 2.5) {
        // Tier 2: Twinkling shimmer
        float s1 = sin(coord.x * 8.0 + time * 2.0) * 0.08;
        float s2 = cos(coord.y * 6.0 + time * 1.5) * 0.06;
        return 1.0 + s1 + s2;
    } else {
        // Tier 3: Prominent shimmer
        float s1 = sin(coord.x * 10.0 + time * 1.8) * 0.10;
        float s2 = cos(coord.y * 8.0 + time * 1.4) * 0.08;
        float sr = sin(length(coord - 0.5) * 15.0 + time * 2.5) * 0.05;
        return 1.0 + s1 + s2 + sr;
    }
}

vec3 getStageColor(float stageIdx, float blend) {
    // Stage-specific color palette
    vec3 color = vec3(0.0, 1.0, 0.8); // Default cyan
    
    // Genesis: Green
    if (stageIdx < 0.5) {
        color = mix(vec3(0.0, 1.0, 0.0), vec3(0.13, 0.5, 0.24), blend);
    }
    // Discipline: Blue
    else if (stageIdx < 1.5) {
        color = mix(vec3(0.12, 0.51, 0.96), vec3(0.23, 0.51, 0.93), blend);
    }
    // Neural: Purple
    else if (stageIdx < 2.5) {
        color = mix(vec3(0.58, 0.33, 0.92), vec3(0.66, 0.33, 0.97), blend);
    }
    // Velocity: Electric purple
    else if (stageIdx < 3.5) {
        color = mix(vec3(0.49, 0.24, 0.87), vec3(0.58, 0.20, 0.93), blend);
    }
    // Architecture: Cyan
    else if (stageIdx < 4.5) {
        color = mix(vec3(0.03, 0.71, 0.83), vec3(0.05, 0.59, 0.76), blend);
    }
    // Harmony: Gold
    else if (stageIdx < 5.5) {
        color = mix(vec3(0.96, 0.62, 0.04), vec3(0.71, 0.46, 0.03), blend);
    }
    // Transcendence: White/Rainbow
    else {
        vec3 white = vec3(1.0, 1.0, 1.0);
        vec3 rainbow = vec3(
            sin(uTime * 0.5) * 0.5 + 0.5,
            sin(uTime * 0.5 + 2.094) * 0.5 + 0.5,
            sin(uTime * 0.5 + 4.189) * 0.5 + 0.5
        );
        color = mix(white, rainbow, 0.2);
    }
    
    return color;
}

// === MAIN ===
void main() {
    vec2 particleCoord = gl_PointCoord;
    
    // Fade-out beyond active count
    float cutoffFade = 1.0;
    if (vParticleIndex >= uActiveCount) {
        discard;  // Don't render particles beyond active count
    } else if (vParticleIndex > uActiveCount - 500.0) {
        // Smooth fade for last 500 particles
        float fadeDistance = vParticleIndex - (uActiveCount - 500.0);
        cutoffFade = 1.0 - (fadeDistance / 500.0);
    }
    
    // Sample sprite from atlas
    vec4 atlasColor = sampleAtlasTexture(vAtlasUVOffset, particleCoord);
    if (atlasColor.a < 0.01) discard;  // Skip transparent pixels
    
    // Get stage-based color
    vec3 stageColor = getStageColor(uStageIndex, vBlend);
    
    // Mix with uniform colors for more variation
    vec3 currentHSV = rgb2hsv(uColorCurrent);
    vec3 nextHSV = rgb2hsv(uColorNext);
    vec3 stageHSV = rgb2hsv(stageColor);
    
    // Blend between current and next stage colors
    vec3 mixHSV = vec3(
        mix(currentHSV.x, nextHSV.x, vBlend),
        mix(currentHSV.y, nextHSV.y, vBlend),
        mix(currentHSV.z, nextHSV.z, vBlend)
    );
    
    // Mix with stage color for richness
    mixHSV = mix(mixHSV, stageHSV, 0.3);
    
    // Per-tier saturation and brightness boost
    float tierIdx = floor(vTierID + 0.5);
    if (tierIdx < 0.5) {
        // Tier 0: Slightly desaturated
        mixHSV.y *= 0.8;
    } else if (tierIdx < 1.5) {
        // Tier 1: Normal saturation
        mixHSV.y *= 1.0;
    } else if (tierIdx < 2.5) {
        // Tier 2: Boosted saturation
        mixHSV.y *= 1.2;
        mixHSV.z *= 1.1;  // Slightly brighter
    } else {
        // Tier 3: Maximum vibrancy
        mixHSV.y *= 1.3;
        mixHSV.z *= 1.2;  // Noticeably brighter
    }
    
    // Clamp saturation and value
    mixHSV.y = clamp(mixHSV.y, 0.0, 1.0);
    mixHSV.z = clamp(mixHSV.z, 0.0, 1.0);
    
    // Convert back to RGB
    vec3 vibrantColor = hsv2rgb(mixHSV);
    
    // Mix with atlas texture for visual interest
    vec3 finalRGB = mix(vibrantColor, vibrantColor * atlasColor.rgb, 0.6);
    
    // Apply shimmer effect
    finalRGB *= shimmer(particleCoord, uTime, vTierID);
    
    // Calculate alpha with multiple factors
    float alpha = vAlpha * atlasColor.a * cutoffFade * uFadeProgress;
    
    // Apply Gaussian falloff for soft edges (if enabled)
    if (uGaussianFalloff > 0.5) {
        float sigma = max(uGaussianSigma, 2.0);
        alpha *= gaussianFalloff(particleCoord, sigma);
    }
    
    // Center weighting for tier 3 particles (if enabled)
    if (uCenterWeighting > 0.5 && vTierID >= 2.5) {
        float centerDist = length(particleCoord - 0.5) * 2.0;
        float centerBoost = 1.0 - smoothstep(0.0, 1.0, centerDist);
        alpha *= mix(1.0, 1.0 + centerBoost * 0.5, uCenterWeighting);
    }
    
    // Final color output
    gl_FragColor = vec4(finalRGB, alpha);
}