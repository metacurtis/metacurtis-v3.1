    scrollRange: [14, 28],
  },
  2: {
    name: 'neural', title: 'Neural Awakening',
    description: '2022-2025: AI Foundation - Mathematical Mastery',
    narrative: 'AI partnership consciousness emerging',
    scrollRange: [28, 42],
  },
  3: {
