import { create } from 'zustand';
import { subscribeWithSelector } from 'zustand/middleware';

// ✅ SST v2.0 CANONICAL IMPORTS
const SST_V2_STAGES = [
  'genesis', 'discipline', 'neural', 'velocity', 
  'architecture', 'harmony', 'transcendence'
];

const SST_V2_QUALITY_TIERS = ['LOW', 'MEDIUM', 'HIGH', 'ULTRA'];

// ✅ DECONTAMINATED: Performance tracking without legacy references
const createPerformanceStore = () => create(
  subscribeWithSelector((set, get) => ({
    // ✅ CORE PERFORMANCE METRICS (API Compatible)
    fps: 60,
    averageFPS: 60,
    frameTime: 16.67,
    memoryUsage: 0,
    
    // ✅ SST v2.0 STAGE SYSTEM (Decontaminated)
    currentStage: 'genesis',
    stageIndex: 0,
    stageProgress: 0,
    totalStages: 7,
    
    // ✅ QUALITY MANAGEMENT (Enhanced)
    qualityTier: 'HIGH',
    adaptiveQuality: true,
    deviceCapabilities: null,
    
    // ✅ PARTICLE SYSTEM METRICS
    particleCount: 2000,
    targetParticleCount: 2000,
    maxParticles: 17000, // SST v2.0 showcase capability
    
    // ✅ WEBGL PERFORMANCE
    drawCalls: 0,
    renderTime: 0,
    bufferMemory: 0,
    
    // ✅ EVENT TRACKING (Decontaminated)
    events: [],
    eventHistory: [],
    maxEvents: 100,
    
    // ✅ SYSTEM HEALTH
    isStable: true,
    errorCount: 0,
    warningCount: 0,
    
    // ✅ ACTIONS: Update FPS metrics
    updateFPS: (fps) => set((state) => {
      const frameTime = fps > 0 ? 1000 / fps : 0;
      return {
        fps: Math.round(fps * 10) / 10,
        frameTime: Math.round(frameTime * 100) / 100,
        averageFPS: Math.round(((state.averageFPS * 0.9) + (fps * 0.1)) * 10) / 10
      };
    }),
    
    // ✅ ACTIONS: Stage management (SST v2.0)
    setStage: (stage) => set((state) => {
      const stageIndex = SST_V2_STAGES.indexOf(stage);
      if (stageIndex === -1) {
        console.warn(`⚠️ Invalid stage: ${stage}, using genesis`);
        return { currentStage: 'genesis', stageIndex: 0 };
      }
      
      console.log(`🎭 SST v2.0 Stage: ${stage} (${stageIndex + 1}/7)`);
      return {
        currentStage: stage,
        stageIndex,
        stageProgress: 0
      };
    }),
    
    setStageProgress: (progress) => set(() => ({
      stageProgress: Math.max(0, Math.min(1, progress))
    })),
    
    // ✅ ACTIONS: Quality management
    setQualityTier: (tier) => set((state) => {
      if (!SST_V2_QUALITY_TIERS.includes(tier)) {
        console.warn(`⚠️ Invalid quality tier: ${tier}, using HIGH`);
        return { qualityTier: 'HIGH' };
      }
      
      console.log(`🎨 Quality tier: ${tier}`);
      return { qualityTier: tier };
    }),
    
    // ✅ ACTIONS: Particle management
    setParticleCount: (count) => set(() => ({
      particleCount: Math.max(0, Math.min(17000, count)),
      targetParticleCount: count
    })),
    
    // ✅ ACTIONS: Device capabilities
    setDeviceCapabilities: (capabilities) => set(() => ({
      deviceCapabilities: capabilities
    })),
    
    // ✅ ACTIONS: WebGL metrics
    updateWebGLMetrics: (metrics) => set(() => ({
      drawCalls: metrics.drawCalls || 0,
      renderTime: metrics.renderTime || 0,
      bufferMemory: metrics.bufferMemory || 0
    })),
    
    // ✅ ACTIONS: Event tracking (decontaminated)
    recordEvent: (type, data = {}) => set((state) => {
      const event = {
        id: Date.now() + Math.random(),
        type,
        data,
        timestamp: Date.now(),
        stage: state.currentStage,
        fps: state.fps
      };
      
      const newEvents = [event, ...state.events].slice(0, state.maxEvents);
      const newHistory = [event, ...state.eventHistory].slice(0, 1000);
      
      // ✅ DECONTAMINATED: Console log without legacy references
      console.log(`📊 Performance Event: ${type}`, data);
      
      return {
        events: newEvents,
        eventHistory: newHistory
      };
    }),
    
    // ✅ ACTIONS: System health
    updateSystemHealth: (health) => set(() => ({
      isStable: health.isStable !== undefined ? health.isStable : true,
      errorCount: health.errorCount || 0,
      warningCount: health.warningCount || 0
    })),
    
    // ✅ GETTERS: Performance summary
    getPerformanceSummary: () => {
      const state = get();
      return {
        fps: state.fps,
        averageFPS: state.averageFPS,
        frameTime: state.frameTime,
        stage: state.currentStage,
        stageProgress: state.stageProgress,
        qualityTier: state.qualityTier,
        particleCount: state.particleCount,
        isStable: state.isStable,
        compliance: 'SST v2.0'
      };
    },
    
    // ✅ GETTERS: System status
    getSystemStatus: () => {
      const state = get();
      return {
        healthy: state.isStable && state.fps > 30,
        performance: state.fps >= 60 ? 'excellent' : state.fps >= 45 ? 'good' : 'needs_optimization',
        stage: `${state.currentStage} (${state.stageIndex + 1}/7)`,
        quality: state.qualityTier,
        particles: `${state.particleCount}/${state.maxParticles}`,
        compliance: 'SST v2.0 Compliant'
      };
    },
    
    // ✅ UTILITIES: Reset to defaults
    reset: () => set(() => ({
      fps: 60,
      averageFPS: 60,
      frameTime: 16.67,
      memoryUsage: 0,
      currentStage: 'genesis',
      stageIndex: 0,
      stageProgress: 0,
      qualityTier: 'HIGH',
      particleCount: 2000,
      targetParticleCount: 2000,
      drawCalls: 0,
      renderTime: 0,
      bufferMemory: 0,
      events: [],
      isStable: true,
      errorCount: 0,
      warningCount: 0
    })),
    
    // ✅ UTILITIES: Clear event history
    clearEvents: () => set(() => ({
      events: [],
      eventHistory: []
    }))
  }))
);

// ✅ CREATE STORE INSTANCE
export const usePerformanceStore = createPerformanceStore();

// ✅ DEVELOPMENT UTILITIES (Decontaminated)
if (typeof window !== 'undefined' && process.env.NODE_ENV === 'development') {
  window.performanceStore = usePerformanceStore;
  window.performanceDebug = {
    getState: () => usePerformanceStore.getState(),
    getSummary: () => usePerformanceStore.getState().getPerformanceSummary(),
    getStatus: () => usePerformanceStore.getState().getSystemStatus(),
    recordEvent: (type, data) => usePerformanceStore.getState().recordEvent(type, data),
    setStage: (stage) => usePerformanceStore.getState().setStage(stage),
    setQuality: (tier) => usePerformanceStore.getState().setQualityTier(tier),
    reset: () => usePerformanceStore.getState().reset()
  };
  
  console.log('📊 PerformanceStore: SST v2.0 Decontaminated (CLEAN)');
  console.log('🎮 Available: window.performanceStore, window.performanceDebug');
  console.log('🎭 Stages:', SST_V2_STAGES.join(' → '));
  console.log('🎨 Quality:', SST_V2_QUALITY_TIERS.join(' → '));
}

// ✅ BRIDGE COMPATIBILITY: Export for atomic integration
export const performanceStore = usePerformanceStore;

// ✅ DEFAULT EXPORT: For legacy import compatibility
export default usePerformanceStore;

// ✅ SST v2.0 VALIDATION
if (typeof window !== 'undefined') {
  const validateSST = () => {
    const expectedStages = 7;
