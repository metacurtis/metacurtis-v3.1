  1340	  /* ────────────────────────────────────────────────────────────────────────
  1341	     ✅ P0 FIX 2-B: Dual-Position Particle Generation with Scaled Coordinates
  1342	     ──────────────────────────────────────────────────────────────────── */
  1343	
  1344	  async generateConstellationParticleData(particleCount, stageConfig) {
  1345	    console.log(`�� Generating particle data: ${particleCount} particles for ${stageConfig.stageName || stageConfig.name}`);
  1346	
  1347	    const atmosphericPositions = new Float32Array(particleCount * 3);
  1348	    const allenAtlasPositions = new Float32Array(particleCount * 3);
  1349	    const animationSeeds = new Float32Array(particleCount * 3);
  1350	    const constellationData = new Float32Array(particleCount * 4);
  1351	
  1352	    const stageName = stageConfig.stageName || stageConfig.name || 'genesis';
  1353	    const brainCoordinates = this.getBrainCoordinatesForStage(stageName);
  1354	    const atmosphericScale = CONSTELLATION_CONSTANTS.ATMOSPHERIC_SCALE;
  1355	    
  1356	    // ✅ P0 FIX 2-B: Brain coordinate scaling factor
  1357	    const brainScale = CONSTELLATION_CONSTANTS.BRAIN_COORDINATE_SCALE;
  1358	
  1359	    for (let i = 0; i < particleCount; i++) {
  1360	      const i3 = i * 3;
  1361	
  1362	      // ✅ ATMOSPHERIC POSITIONS: Cosmic dust start state
  1363	      const theta = Math.random() * Math.PI * 2;
  1364	      const phi = Math.random() * Math.PI;
  1365	      const radius = 2 + Math.random() * 6; // 2-8 unit spread
  1366	      
  1367	      atmosphericPositions[i3] = radius * Math.sin(phi) * Math.cos(theta);
  1368	      atmosphericPositions[i3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
  1369	      atmosphericPositions[i3 + 2] = radius * Math.cos(phi);
  1370	
  1371	      // ✅ ALLEN ATLAS POSITIONS: Scaled brain coordinates
  1372	      if (brainCoordinates.length > 0) {
  1373	        const coord = brainCoordinates[i % brainCoordinates.length];
  1374	        // ✅ P0 FIX 2-B: Apply scaling to make brain formations visible
  1375	        allenAtlasPositions[i3] = coord.x * brainScale;
  1376	        allenAtlasPositions[i3 + 1] = coord.y * brainScale;
  1377	        allenAtlasPositions[i3 + 2] = coord.z * brainScale;
  1378	      } else {
  1379	        // ✅ P0 FIX 2-B: Scaled fallback brain distribution
  1380	        allenAtlasPositions[i3] = (Math.random() - 0.5) * 8.0;     // Scaled: was 4
  1381	        allenAtlasPositions[i3 + 1] = (Math.random() - 0.5) * 6.0; // Scaled: was 3  
  1382	        allenAtlasPositions[i3 + 2] = (Math.random() - 0.5) * 4.0; // Scaled: was 2
  1383	      }
  1384	
  1385	      // Animation timing variation
  1386	      animationSeeds[i3] = Math.random() * Math.PI * 2;
  1387	      animationSeeds[i3 + 1] = Math.random() * Math.PI * 2;
  1388	      animationSeeds[i3 + 2] = Math.random() * Math.PI * 2;
  1389	
  1390	      // Constellation grouping data
  1391	      constellationData[i * 4] = 0; // Region ID
  1392	      constellationData[i * 4 + 1] = 0; // Distance from center
  1393	      constellationData[i * 4 + 2] = 0; // Angular position
  1394	      constellationData[i * 4 + 3] = 0; // Elevation
  1395	    }
  1396	
  1397	    console.log(`✅ Generated ${particleCount} dual-position particles for ${stageName} (brain scale: ${brainScale}x)`);
  1398	    
  1399	    return {
  1400	      atmosphericPositions,
  1401	      allenAtlasPositions,
  1402	      animationSeeds,
  1403	      constellationData,
  1404	      activeRegions: await this.getActiveRegions(stageName),
  1405	      particleCount
  1406	    };
  1407	  }
