  3080	  return indexToStage[nextIndex];
  3081	};
  3082	
  3083	/**
  3084	 * Get previous stage name
  3085	 * @param {string} currentStage - Current stage name
  3086	 * @returns {string} - Previous stage name (cycles to last)
  3087	 */
  3088	export const getPrevStage = currentStage => {
  3089	  const currentIndex = stageToIndex[currentStage] ?? 0;
  3090	  const prevIndex = currentIndex === 0 ? CANONICAL_STAGES.length - 1 : currentIndex - 1;
  3091	  return indexToStage[prevIndex];
  3092	};
