// ✅ PHASE II-A BRIDGE: Seamless qualityStore → qualityAtom Migration
// Zero breaking changes during atomic transition

import { qualityAtom } from '@/utils/atoms/qualityAtom.js';

/**
 * ✅ QUALITY BRIDGE - Seamless Migration Pattern
 * 
 * Enables gradual migration from Zustand qualityStore to atomic qualityAtom
 * - Maintains API compatibility during transition
 * - Provides rollback capability if needed
 * - Validates state synchronization
 * - Supports A/B testing between implementations
 */

class QualityBridgeManager {
  constructor() {
    this.isActive = false;
    this.migrationMode = 'STAGED'; // STAGED | IMMEDIATE | ROLLBACK
    this.syncErrors = [];
    this.lastSync = 0;
    this.syncCount = 0;
    
    console.log('🌉 qualityBridge: Migration bridge initialized');
  }

  // ✅ ACTIVATION: Start bridge synchronization
  activate(mode = 'STAGED') {
    this.migrationMode = mode;
    this.isActive = true;
    this.lastSync = performance.now();
    
    // Subscribe to atomic store changes for sync validation
    this.unsubscribe = qualityAtom.subscribe((newState, prevState) => {
      this.validateSync(newState, prevState);
    });
    
    console.log(`🌉 qualityBridge: Activated in ${mode} mode`);
    
    // Initial sync validation
    this.performInitialSync();
    
    return this;
  }

  // ✅ DEACTIVATION: Stop bridge operations
  deactivate() {
    this.isActive = false;
    
    if (this.unsubscribe) {
      this.unsubscribe();
      this.unsubscribe = null;
    }
    
    console.log('🌉 qualityBridge: Deactivated - migration complete');
  }

  // ✅ INITIAL SYNC: Validate starting state consistency
  performInitialSync() {
    try {
      const atomicState = qualityAtom.getState();
      
      // If there's an existing Zustand store, validate consistency
      if (typeof window !== 'undefined' && window.useQualityStore) {
        const zustandState = window.useQualityStore.getState();
        
        const consistencyCheck = {
          qualityTier: atomicState.currentQualityTier === zustandState.currentQualityTier,
          particleCount: Math.abs(atomicState.particleCount - zustandState.particleCount) < 100,
          webglEnabled: atomicState.webglEnabled === zustandState.webglEnabled,
          deviceType: atomicState.deviceType === zustandState.deviceType
        };
        
        const isConsistent = Object.values(consistencyCheck).every(check => check === true);
        
        if (isConsistent) {
          console.log('✅ qualityBridge: Initial state consistency verified');
        } else {
          console.warn('⚠️ qualityBridge: State inconsistency detected:', consistencyCheck);
          this.syncErrors.push({
            type: 'initial_inconsistency',
            checks: consistencyCheck,
            timestamp: Date.now()
          });
        }
      }
      
      this.syncCount++;
      
    } catch (error) {
      console.error('🌉 qualityBridge: Initial sync failed:', error);
      this.syncErrors.push({
        type: 'initial_sync_error',
        error: error.message,
        timestamp: Date.now()
      });
    }
  }

  // ✅ SYNC VALIDATION: Continuous state consistency checking
  validateSync(newState, prevState) {
    if (!this.isActive) return;
    
    try {
      const now = performance.now();
      const timeSinceLastSync = now - this.lastSync;
      
      // Validate critical state changes
      const criticalChanges = {
        qualityTierChanged: newState.currentQualityTier !== prevState.currentQualityTier,
        particleCountChanged: newState.particleCount !== prevState.particleCount,
        showcaseModeChanged: newState.showcaseMode !== prevState.showcaseMode,
        webglStateChanged: newState.webglEnabled !== prevState.webglEnabled
      };
      
      const hasCriticalChanges = Object.values(criticalChanges).some(change => change === true);
      
      if (hasCriticalChanges) {
        console.log('🔄 qualityBridge: Critical state change detected:', {
          changes: criticalChanges,
          newTier: newState.currentQualityTier,
          newParticles: newState.particleCount,
          showcase: newState.showcaseMode
        });
        
        // Emit bridge event for other systems
        if (typeof window !== 'undefined') {
          window.dispatchEvent(new CustomEvent('qualityBridgeSync', {
            detail: {
              changes: criticalChanges,
              state: newState,
              migrationMode: this.migrationMode,
              timestamp: now
            }
          }));
        }
      }
      
      this.lastSync = now;
      this.syncCount++;
      
    } catch (error) {
      console.error('🌉 qualityBridge: Sync validation failed:', error);
      this.syncErrors.push({
        type: 'sync_validation_error',
        error: error.message,
        timestamp: Date.now()
      });
    }
  }

  // ✅ MIGRATION HELPERS: Support different migration strategies
  
  // Gradual migration - move one component at a time
  enableGradualMigration(componentName) {
    console.log(`🔄 qualityBridge: ${componentName} migrated to atomic store`);
    
    // Track which components have migrated
    if (!this.migratedComponents) {
      this.migratedComponents = new Set();
    }
    this.migratedComponents.add(componentName);
    
    // Check if migration is complete
    const expectedComponents = ['WebGLBackground', 'AdaptiveQualitySystem', 'DevPerformanceMonitor'];
    const allMigrated = expectedComponents.every(comp => this.migratedComponents.has(comp));
    
    if (allMigrated) {
      console.log('🎉 qualityBridge: All components migrated - bridge can be deactivated');
    }
    
    return allMigrated;
  }

  // A/B testing support
  enableABTesting(testGroup = 'A') {
    this.testGroup = testGroup;
    console.log(`🧪 qualityBridge: A/B testing enabled - Group ${testGroup}`);
    
    // Group A: Use atomic store
    // Group B: Use Zustand store (for comparison)
    return testGroup === 'A' ? 'atomic' : 'zustand';
  }

  // Rollback capability
  initiateRollback(reason = 'manual') {
    console.warn(`🔄 qualityBridge: Rollback initiated - ${reason}`);
    
    this.migrationMode = 'ROLLBACK';
    
    // Log rollback event
    this.syncErrors.push({
      type: 'rollback_initiated',
      reason,
      timestamp: Date.now(),
      syncCount: this.syncCount
    });
    
    // Emit rollback event
    if (typeof window !== 'undefined') {
      window.dispatchEvent(new CustomEvent('qualityBridgeRollback', {
        detail: { reason, timestamp: Date.now() }
      }));
    }
    
    return true;
  }

  // ✅ STATUS REPORTING: Bridge health and migration progress
  getStatus() {
    const atomicState = qualityAtom.getState();
    
    return {
      isActive: this.isActive,
      migrationMode: this.migrationMode,
      syncCount: this.syncCount,
      errorCount: this.syncErrors.length,
      lastSync: this.lastSync,
      
      // Current atomic state
      currentState: {
        qualityTier: atomicState.currentQualityTier,
        particleCount: atomicState.particleCount,
        showcaseMode: atomicState.showcaseMode,
        showcaseCapable: atomicState.sstCompliance.showcaseCapable,
        sstCompliant: atomicState.sstCompliance.valid
      },
      
      // Migration progress
      migratedComponents: this.migratedComponents ? Array.from(this.migratedComponents) : [],
      testGroup: this.testGroup,
      
      // Health metrics
      timeSinceLastSync: performance.now() - this.lastSync,
      recentErrors: this.syncErrors.slice(-3) // Last 3 errors
    };
  }

  getHealthReport() {
    const status = this.getStatus();
    const errorRate = status.syncCount > 0 ? status.errorCount / status.syncCount : 0;
    
    const health = {
      overall: 'healthy',
      errorRate: errorRate,
      syncFrequency: status.syncCount / ((performance.now() - this.lastSync + 1000) / 1000), // per second
      recommendations: []
    };
    
    // Health assessment
    if (errorRate > 0.05) {
      health.overall = 'warning';
      health.recommendations.push('High error rate detected - investigate sync issues');
    }
    
    if (status.timeSinceLastSync > 10000) {
      health.overall = 'warning';
      health.recommendations.push('No recent sync activity - check if bridge is needed');
    }
    
    if (status.errorCount === 0 && status.syncCount > 10) {
      health.recommendations.push('Migration appears stable - consider completing migration');
    }
    
    return health;
  }

  // ✅ DEVELOPMENT UTILITIES
  forceSyncTest() {
    if (process.env.NODE_ENV === 'development') {
      console.log('🧪 qualityBridge: Force sync test');
      
      // Trigger a quality tier change to test sync
      const currentTier = qualityAtom.getState().currentQualityTier;
      const testTier = currentTier === 'HIGH' ? 'ULTRA' : 'HIGH';
      
      qualityAtom.setCurrentQualityTier(testTier);
      
      setTimeout(() => {
        qualityAtom.setCurrentQualityTier(currentTier);
        console.log('🧪 qualityBridge: Sync test complete');
      }, 1000);
    }
  }

  clearErrors() {
    this.syncErrors = [];
    console.log('🌉 qualityBridge: Error log cleared');
  }
}

// ✅ SINGLETON BRIDGE INSTANCE
const qualityBridge = new QualityBridgeManager();

// ✅ DEVELOPMENT ACCESS
if (typeof window !== 'undefined' && process.env.NODE_ENV === 'development') {
  window.qualityBridge = qualityBridge;
  
  window.qualityBridgeControls = {
    activate: (mode) => qualityBridge.activate(mode),
    deactivate: () => qualityBridge.deactivate(),
    getStatus: () => qualityBridge.getStatus(),
    getHealth: () => qualityBridge.getHealthReport(),
    enableGradual: (comp) => qualityBridge.enableGradualMigration(comp),
    enableAB: (group) => qualityBridge.enableABTesting(group),
    rollback: (reason) => qualityBridge.initiateRollback(reason),
    syncTest: () => qualityBridge.forceSyncTest(),
    clearErrors: () => qualityBridge.clearErrors()
  };
  
  console.log('🌉 qualityBridge: Migration bridge ready');
  console.log('🎮 Controls: window.qualityBridgeControls');
  console.log('🔄 Start migration: window.qualityBridgeControls.activate("STAGED")');
}

export default qualityBridge;
